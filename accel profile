def check_against_model(kin, sigma=SIGMA_M, l=L_M):
    """kin = your BorescopeKinematics. Recovers lambda, phi, alpha from its neck positions, recomputes with
    forward_kinematics() and prints the camera-position error. ~0 mm = same h1 and conventions."""
    start = np.asarray(kin.neck_translation_position_meters, float)
    neck = np.asarray(kin.neck_position_meters, float)
