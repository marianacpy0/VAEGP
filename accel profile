"""
accel_profile.py - the borescope kinematics driven by ACCELERATION (option A).

    input : mu_ddot(t) = [theta_ddot, alpha_ddot, lambda_ddot, beta_ddot]   (rad/s^2, m/s^2)
    state : mu = [theta, alpha, lambda, beta],  mu_dot
    output: r(t) = h1(p, mu(t))  -> neck start, neck arc, neck end, camera   (port frame, metres)

Integration is exact for an acceleration that is constant over each step (double integrator):
    mu_dot[k+1] = mu_dot[k] + dt * u[k]
    mu[k+1]     = mu[k] + dt * mu_dot[k] + 0.5 * dt^2 * u[k]
Box constraints (lower/upper bounds on mu, mu_dot, mu_ddot) are enforced every step and reported.

Conventions (from the slides):
    frame : origin at the inspection port, +Y = insertion, +Z = up, X = Y x Z
    theta : theta = pi - sigma/rho   ->  theta = pi is a straight neck. Bend angle phi = pi - theta = sigma/rho
    alpha : rotation of the bending plane about +Y. alpha = 0 bends toward +Z (right-hand rule about +Y)
    lambda: unsupported length, port -> start of the neck, along +Y
    beta  : roll of the probe about +Y (turns the camera image; the neck bends in the alpha plane)
If your model's h1 differs, replace forward_kinematics() below: everything else stays the same.
check_against_model(kin) compares this h1 with your model's own output.

Use in Python:
    import accel_profile as A
    kin = A.AccelKinematics(A.EXAMPLE_SEGMENTS)       # or your own segments / function
    kin.camera_position_meters                        # (N, 3)
In Isaac: port_probe.py with SOURCE = "accel" drives the jointed probe with it.
"""
import math
import numpy as np

# =============================================================================
# SETTINGS
# =============================================================================
SIGMA_M = 0.050          # bending neck length sigma
L_M     = 0.020          # neck end -> camera, l
DT      = 0.01           # integration / output step [s]
N_ARC   = 25             # points along the neck arc
EPS     = 1e-9           # tolerance before a bound counts as hit

MU0     = [math.pi, 0.0, 0.0, 0.0]     # initial [theta, alpha, lambda, beta]: straight neck at the port
MU0_DOT = [0.0, 0.0, 0.0, 0.0]         # initial velocities

# Box constraints: (lower, upper) for each of theta, alpha, lambda, beta
BOUNDS = dict(
    mu       =[(math.pi - math.radians(120), math.pi), (-math.pi, math.pi), (0.0, 0.40), (-math.pi, math.pi)],
    mu_dot   =[(-1.0, 1.0), (-1.0, 1.0), (-0.05, 0.05), (-1.0, 1.0)],     # rad/s, m/s
    mu_ddot  =[(-2.0, 2.0), (-2.0, 2.0), (-0.10, 0.10), (-2.0, 2.0)],     # rad/s^2, m/s^2
)

# Acceleration profile: list of (duration_s, [theta_ddot, alpha_ddot, lambda_ddot, beta_ddot]),
# each held constant for its duration. Accelerate then brake with the same value -> moves and stops.
# (theta_ddot < 0 bends the neck, because theta = pi is straight.)
EXAMPLE_SEGMENTS = [
    (0.5, [0.0, 0.0, 0.0, 0.0]),          # hold
    (1.0, [0.0, 0.0, 0.05, 0.0]),         # push in: speed up ...
    (1.0, [0.0, 0.0, -0.05, 0.0]),        # ... and brake        -> +50 mm
    (1.0, [-0.5, 0.0, 0.0, 0.0]),         # bend the neck ...
    (1.0, [0.5, 0.0, 0.0, 0.0]),          # ... and stop         -> 0.5 rad (29 deg) of bend
    (1.0, [0.0, 0.8, 0.0, 0.0]),          # swing the bending plane ...
    (1.0, [0.0, -0.8, 0.0, 0.0]),         # ... and stop         -> alpha 0.8 rad (46 deg)
    (1.0, [0.0, 0.0, 0.0, 0.6]),          # roll the probe ...
    (1.0, [0.0, 0.0, 0.0, -0.6]),         # ... and stop         -> beta 0.6 rad (34 deg)
    (0.5, [0.0, 0.0, 0.0, 0.0]),          # hold
]


# =============================================================================
# h1: forward kinematics (replace this if your model's convention differs)
# =============================================================================
def forward_kinematics(mu, sigma=SIGMA_M, l=L_M, n_arc=N_ARC):
    """mu = [theta, alpha, lambda, beta] -> dict(start, arc (n_arc,3), neck_end, camera, tangent, up), port frame."""
    theta, alpha, lam, beta = (float(v) for v in mu)
    phi = math.pi - theta                                   # bend angle = sigma / rho
    Y = np.array([0.0, 1.0, 0.0])
    N = np.array([math.sin(alpha), 0.0, math.cos(alpha)])  # bending direction: +Z turned by alpha about +Y
    start = lam * Y
    s = np.linspace(0.0, sigma, n_arc)
    if abs(phi) < 1e-9:                                     # straight neck
        arc = start + s[:, None] * Y
        T = Y
    else:
        k = phi / sigma                                     # curvature 1/rho
        arc = start + (np.sin(k * s) / k)[:, None] * Y + ((1 - np.cos(k * s)) / k)[:, None] * N
        T = math.cos(phi) * Y + math.sin(phi) * N           # tangent at the neck end
    neck_end = arc[-1]
    camera = neck_end + l * T
    # camera "up" before roll = the bending direction turned with the neck, then rolled by beta about T
    U = -math.sin(phi) * Y + math.cos(phi) * N
    U = U * math.cos(beta) + np.cross(T, U) * math.sin(beta) + T * np.dot(T, U) * (1 - math.cos(beta))
    return dict(start=start, arc=arc, neck_end=neck_end, camera=camera, tangent=T, up=U)


# =============================================================================
# acceleration -> mu(t) (double integrator with box constraints)
# =============================================================================
def integrate(accel, t_end=None, dt=DT, mu0=MU0, mu0_dot=MU0_DOT, bounds=BOUNDS):
    """accel: list of (duration, [4 accelerations]) OR a function u(t) -> 4 accelerations (then give t_end).
    Returns t (N,), mu (N,4), mu_dot (N,4), mu_ddot (N,4), log (list of constraint events)."""
    if callable(accel):
        if t_end is None:
            raise ValueError("give t_end when accel is a function")
        u_of_t = accel
    else:
        ends = np.cumsum([d for d, _ in accel])
        vals = [np.asarray(a, float) for _, a in accel]
        t_end = float(ends[-1])
        u_of_t = lambda t: vals[min(int(np.searchsorted(ends, t + 1e-12, side="right")), len(vals) - 1)]
    lo = {k: np.array([b[0] for b in v]) for k, v in bounds.items()}
    hi = {k: np.array([b[1] for b in v]) for k, v in bounds.items()}
    n = int(round(t_end / dt))
    t = np.arange(n + 1) * dt
    mu = np.zeros((n + 1, 4))
    md = np.zeros((n + 1, 4))
    mdd = np.zeros((n + 1, 4))
    mu[0], md[0] = np.asarray(mu0, float), np.asarray(mu0_dot, float)
    names = ("theta", "alpha", "lambda", "beta")
    log, hit = [], set()

    def note(kind, i, k, tk):
        if (kind, i) not in hit:
            hit.add((kind, i))
            log.append(f"t={tk:6.2f}s  {names[i]}: {kind} limit reached, clipped")

    for k in range(n):
        u = np.asarray(u_of_t(t[k]), float).copy()
        for i in range(4):                                   # acceleration bounds
            if u[i] < lo["mu_ddot"][i] - EPS or u[i] > hi["mu_ddot"][i] + EPS:
                note("acceleration", i, k, t[k])
        u = np.clip(u, lo["mu_ddot"], hi["mu_ddot"])
        v = md[k] + dt * u
        for i in range(4):                                   # velocity bounds -> reduce the acceleration
            if v[i] < lo["mu_dot"][i] - EPS or v[i] > hi["mu_dot"][i] + EPS:
                note("velocity", i, k, t[k])
                v[i] = np.clip(v[i], lo["mu_dot"][i], hi["mu_dot"][i])
                u[i] = (v[i] - md[k][i]) / dt
        x = mu[k] + dt * md[k] + 0.5 * dt * dt * u
        for i in range(4):                                   # position bounds -> stop there
            if x[i] < lo["mu"][i] - EPS or x[i] > hi["mu"][i] + EPS:
                note("position", i, k, t[k])
                x[i] = np.clip(x[i], lo["mu"][i], hi["mu"][i])
                v[i] = 0.0
                u[i] = (v[i] - md[k][i]) / dt
        mu[k + 1], md[k + 1], mdd[k] = x, v, u
    mdd[-1] = mdd[-2] if n > 0 else 0.0
    return t, mu, md, mdd, log


