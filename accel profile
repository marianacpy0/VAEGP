def recover_mu(start, neck_end, roll=0.0, sigma=SIGMA_M):
    """[theta, alpha, lambda, beta] from the neck start and neck end (port frame), with this file's h1."""
    start, neck_end = np.asarray(start, float), np.asarray(neck_end, float)
    d = neck_end - start
    perp = np.array([d[0], 0.0, d[2]])
    chord = min(float(np.linalg.norm(d)), sigma)
    lo_, hi_ = 0.0, 2 * math.pi - 1e-6                         # chord / sigma = sin(phi/2) / (phi/2)
    for _ in range(60):
        m = 0.5 * (lo_ + hi_)
        if (math.sin(m / 2) / (m / 2) if m > 1e-9 else 1.0) > chord / sigma:
            lo_ = m
        else:
            hi_ = m
    phi = 0.5 * (lo_ + hi_)
    alpha = math.atan2(perp[0], perp[2]) if np.linalg.norm(perp) > 1e-6 else 0.0
    return np.array([math.pi - phi, alpha, float(start[1]), float(roll)])


def segments_to_reach(mu0, mu1, duration, hold_start=0.0, hold_end=0.0):
    """Bang-bang accelerations: every channel speeds up for half the time, brakes for the other half,
    and lands exactly on mu1 with zero speed (a = 4 * delta / T^2)."""
    d = np.asarray(mu1, float) - np.asarray(mu0, float)
    d[1] = (d[1] + math.pi) % (2 * math.pi) - math.pi          # alpha / beta: the short way round
    d[3] = (d[3] + math.pi) % (2 * math.pi) - math.pi
    a = 4.0 * d / duration ** 2
    segs = [(hold_start, [0.0] * 4)] if hold_start > 0 else []
    segs += [(duration / 2, a.tolist()), (duration / 2, (-a).tolist())]
    if hold_end > 0:
        segs.append((hold_end, [0.0] * 4))
    return segs


def _interp_fk(t, idx, sub):
    """Linear interpolation in time of h1 outputs evaluated at t[idx] -> one dict per t."""
    out = {}
    for k in sub[0]:
        A = np.stack([np.asarray(f[k], float) for f in sub])            # (n_sub, ...)
        flat = A.reshape(len(idx), -1)
        full = np.stack([np.interp(t, t[idx], flat[:, c]) for c in range(flat.shape[1])], 1)
        out[k] = full.reshape((len(t),) + A.shape[1:])
    return [{k: out[k][j] for k in out} for j in range(len(t))]


