# check this h1 against your model's output (same conventions?)
# =============================================================================
def check_against_model(kin, sigma=SIGMA_M, l=L_M):
    """kin = your BorescopeKinematics. Recovers lambda, phi, alpha from its neck positions, recomputes with
    forward_kinematics() and prints the camera-position error. ~0 mm = same h1 and conventions."""
    start = np.asarray(kin.neck_translation_position_meters, float)
    neck = np.asarray(kin.neck_position_meters, float)
    cam = np.asarray(kin.camera_position_meters, float)
    err = []
    for s0, ne, c in zip(start, neck, cam):
        lam = float(s0[1])
        d = ne - s0
        along, perp = d[1], np.array([d[0], 0.0, d[2]])
        chord = float(np.linalg.norm(d))
        lo_, hi_ = 0.0, 2 * math.pi - 1e-6                     # chord / sigma = sin(phi/2) / (phi/2)
        for _ in range(60):
            m = 0.5 * (lo_ + hi_)
            if (math.sin(m / 2) / (m / 2) if m > 1e-9 else 1.0) > chord / sigma:
                lo_ = m
            else:
                hi_ = m
        phi = 0.5 * (lo_ + hi_)
        alpha = math.atan2(perp[0], perp[2]) if np.linalg.norm(perp) > 1e-9 else 0.0
        f = forward_kinematics([math.pi - phi, alpha, lam, 0.0], sigma, l)
        err.append([np.linalg.norm(f["start"] - s0), np.linalg.norm(f["neck_end"] - ne), np.linalg.norm(f["camera"] - c)])
    err = np.array(err) * 1000
    print(f"[check] vs your model: neck start max {err[:, 0].max():.3f} mm | neck end max {err[:, 1].max():.3f} mm | "
          f"camera max {err[:, 2].max():.3f} mm")
    print("[check] ~0 everywhere = same h1. Neck end OK but camera off = the camera direction differs. "
          "Start off = your model moves the neck start off the Y axis (pivot at the port).")
    return err


