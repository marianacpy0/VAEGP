"""
minimal_attachment_test.py

ONE QUESTION: does create_auto_deformable_attachment ever produce a
non-empty vertex list in this Isaac Sim 6.0.1-rc.7 build, on ANYTHING?

Deliberately as simple as possible -- one small deformable cube, fully
swallowed inside a much bigger rigid box (guaranteed massive overlap,
no cleverness, no custom mesh generation). If this doesn't work, the
problem is the API/build, not our probe geometry -- run this before
touching build_probe_deflection_test.py again.

Run in STOP. Do NOT hit Play -- we're only checking the vertex list
right after creation, not simulating anything yet.
"""

from pxr import UsdGeom, UsdPhysics, UsdShade, Gf
import omni.usd
from omni.physx.scripts import deformableUtils
from omni.physx import get_physx_cooking_interface


def get_stage():
    return omni.usd.get_context().get_stage()


def run_test():
    stage = get_stage()

    for path in ("/World/TestBigBox", "/World/TestSmallDeformable", "/World/TestAttachment"):
        prim = stage.GetPrimAtPath(path)
        if prim.IsValid():
            stage.RemovePrim(path)

    # Big rigid box: 20cm cube, centered at origin.
    big_box = UsdGeom.Cube.Define(stage, "/World/TestBigBox")
    big_box.CreateSizeAttr(0.20)
    rigid_body = UsdPhysics.RigidBodyAPI.Apply(big_box.GetPrim())
    rigid_body.CreateKinematicEnabledAttr(True)
    UsdPhysics.CollisionAPI.Apply(big_box.GetPrim())
    print("Big rigid box created: 20cm cube at origin")

    # Small deformable cube: 5cm cube, ALSO centered at origin -- fully
    # inside the big box, maximum possible overlap, zero ambiguity.
    small_cube_mesh = UsdGeom.Cube.Define(stage, "/World/TestSmallDeformable")
    small_cube_mesh.CreateSizeAttr(0.05)
    small_prim = small_cube_mesh.GetPrim()

    success = deformableUtils.create_auto_volume_deformable_hierarchy(
        stage=stage,
        root_prim_path=small_prim.GetPath(),
        simulation_tetmesh_path="/World/TestSmallDeformable/SimMesh",
        collision_tetmesh_path="/World/TestSmallDeformable/CollMesh",
        cooking_src_mesh_path="/World/TestSmallDeformable",
        simulation_hex_mesh_enabled=True,
        cooking_src_simplification_enabled=False,
        set_visibility_with_guide_purpose=False,
    )
    print(f"Small deformable created, hierarchy build success: {success}")

    material = UsdShade.Material.Define(stage, "/World/Looks/TestDeformableMaterial")
    mat_prim = material.GetPrim()
    mat_prim.ApplyAPI("OmniPhysicsBaseMaterialAPI")
    mat_prim.GetAttribute("omniphysics:dynamicFriction").Set(0.4)
    mat_prim.GetAttribute("omniphysics:density").Set(1000.0)
    mat_prim.ApplyAPI("OmniPhysicsDeformableMaterialAPI")
    mat_prim.GetAttribute("omniphysics:youngsModulus").Set(1.0e7)
    mat_prim.GetAttribute("omniphysics:poissonsRatio").Set(0.4)
    mat_prim.ApplyAPI("PhysxDeformableMaterialAPI")
    mat_prim.GetAttribute("physxDeformableMaterial:elasticityDamping").Set(0.01)
    UsdShade.MaterialBindingAPI.Apply(small_prim).Bind(material, UsdShade.Tokens.weakerThanDescendants, "physics")

    get_physx_cooking_interface().cook_auto_deformable_body(str(small_prim.GetPath()))

    attach_success = deformableUtils.create_auto_deformable_attachment(
        stage, "/World/TestAttachment", str(small_prim.GetPath()), "/World/TestBigBox"
    )
    print(f"Attachment call returned: {attach_success}")

    # Read the vertex list back directly -- this is the actual answer.
    vtx_prim = stage.GetPrimAtPath("/World/TestAttachment/vtx_xform_attachment")
    if not vtx_prim.IsValid():
        print("RESULT: vtx_xform_attachment prim doesn't exist at all -- attachment creation failed structurally.")
        return

    indices_attr = vtx_prim.GetAttribute("physxAutoDeformableAttachment:vertexIndicesSource0")
    if not indices_attr.IsValid():
        # Attribute name may differ slightly -- print everything on the prim so we can see the real one.
        print("Couldn't find expected attribute name -- listing ALL attributes on vtx_xform_attachment:")
        for attr in vtx_prim.GetAttributes():
            print(f"  {attr.GetName()} = {attr.Get()}")
        return

    indices = indices_attr.Get()
    print(f"RESULT: Vertex Indices Source 0 = {indices}")
    print(f"RESULT: count = {len(indices) if indices else 0}")


if __name__ == "__main__":
    run_test()
