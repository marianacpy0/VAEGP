# RUN
# =============================================================================
def main():
    ctx = omni.usd.get_context()
    if USD_PATH:
        print(f"[borescope] opening {USD_PATH}")
        ctx.open_stage(USD_PATH)
    if ctx.get_stage() is None:
        print("[borescope] ERROR: no stage open")
        return None

    scope = Borescope()
    if not scope.find_port(PORT_PRIM_PATH):
        print(f"[borescope] ERROR: port '{PORT_PRIM_PATH}' not found or has no mesh")
        return None
    scope.build()
    set_auto_exposure(AUTO_EXPOSURE)
    if HIDE_CAMERA_GIZMO:
        hide_camera_gizmo(scope.stage, scope.cam_path)
    tex_report = apply_surface_textures(scope.stage, scope.mpu)
    crack_report = add_crack(scope)
    if ANIMATE:
        bake_inspection(scope)
    for r in tex_report:
        print("[surface]", r)
    if crack_report:
        print("[surface]", crack_report)

    rp_path = None
    if CREATE_RENDER_PRODUCT:
        try:
            import omni.replicator.core as rep
            rp = rep.create.render_product(scope.cam_path, CAM_RES)
            rp_path = rp.path if hasattr(rp, "path") else str(rp)
        except Exception as e:
            print(f"[borescope] render product failed: {e}")
    if LOOK_THROUGH_BORESCOPE:
        try:
            from omni.kit.viewport.utility import get_active_viewport
            get_active_viewport().camera_path = scope.cam_path
        except Exception as e:
            print(f"[borescope] could not switch viewport camera: {e}")

    line = "-" * 72
    print(line)
    print("[borescope] built at", ROOT_PATH)
    print(scope.info)
    print(f"Pose: lambda {LAMBDA_MM} mm | theta {THETA_DEG} deg | alpha {ALPHA_DEG} deg | "
          f"beta {BETA_DEG} deg | gravity sag {'ON' if GRAVITY_SAG else 'OFF'}")
    print(scope.pose_text)
    print(f"Camera prim : {scope.cam_path}  (gizmo {'hidden' if HIDE_CAMERA_GIZMO else 'visible'})")
    print(f"LED prim    : {ROOT_PATH}/Tip/LED  (exposure {LED_EXPOSURE}, cone {LED_CONE_DEG} deg)")
    if rp_path:
        print(f"Render product: {rp_path}")
    print(line)
    return scope


borescope = main()
