# position_at_port_inner_mouth.py
# Run inside Isaac Sim's Script Editor.
#
# We've been guessing a "pullback" distance from the cutter's CENTER,
# which put us either embedded in the wall or floating way outside the
# engine. The cutter is a cylinder bored straight through the casing --
# it has two ends: an outer end (outside) and an inner end (facing the
# blades). This finds that inner end directly from the mesh's own
# object-space shape, instead of guessing a distance along a line.

from pxr import Usd, UsdGeom, Gf
import omni.usd

stage = omni.usd.get_context().get_stage()
ROOT = "/World/ScaledEngineWPorts"
CYLINDER_PATH = f"{ROOT}/Port_LPC_cutter/Cylinder"
CAM_XFORM = "/World/BorescopeCam"

NUDGE = 0.01  # meters past the inner end, into open air toward the rotor

bbox_cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_])

cyl_prim = stage.GetPrimAtPath(CYLINDER_PATH)
assert cyl_prim.IsValid(), f"Not found: {CYLINDER_PATH}"

# 1) Object-space (untransformed) bound -- the cylinder's own shape,
#    before any rotation/translation, so we can find its true long axis.
local_bound = bbox_cache.ComputeUntransformedBound(cyl_prim)
local_range = local_bound.ComputeAlignedRange()
local_size = local_range.GetSize()
axis = max(range(3), key=lambda i: local_size[i])  # 0=X, 1=Y, 2=Z
print(f"Cylinder object-space size: {tuple(local_size)} -- long axis = {'XYZ'[axis]}")

lo = list(local_range.GetMin())
hi = list(local_range.GetMax())
center = list(local_range.GetMidpoint())

# Two candidate endpoints, centered on the other two axes
end_a = Gf.Vec3d(*[lo[axis] if i == axis else center[i] for i in range(3)])
end_b = Gf.Vec3d(*[hi[axis] if i == axis else center[i] for i in range(3)])

# 2) Transform both endpoints to world space
xf = UsdGeom.Xformable(cyl_prim)
mat = xf.ComputeLocalToWorldTransform(Usd.TimeCode.Default())
world_a = mat.Transform(end_a)
world_b = mat.Transform(end_b)

# 3) Whichever endpoint is closer to the rotor is the INNER mouth
rotor_prim = stage.GetPrimAtPath(f"{ROOT}/rotor")
rotor_center = Gf.Vec3d(bbox_cache.ComputeWorldBound(rotor_prim).ComputeAlignedRange().GetMidpoint())

dist_a = (rotor_center - world_a).GetLength()
dist_b = (rotor_center - world_b).GetLength()
inner_point = world_a if dist_a < dist_b else world_b
print(f"End A: {world_a}  dist to rotor: {dist_a:.3f}")
print(f"End B: {world_b}  dist to rotor: {dist_b:.3f}")
print(f"Inner mouth (closer to rotor): {inner_point}")

# 4) Place camera just past the inner mouth, aimed at the rotor
direction = (rotor_center - inner_point).GetNormalized()
cam_pos = inner_point + direction * NUDGE

cam_xform = UsdGeom.Xformable(stage.GetPrimAtPath(CAM_XFORM))
ops = {op.GetOpName(): op for op in cam_xform.GetOrderedXformOps()}
ops["xformOp:translate"].Set(cam_pos)

default_forward = Gf.Vec3d(0, 0, -1)
look_rotation = Gf.Rotation(default_forward, direction)
q = look_rotation.GetQuaternion()
ops["xformOp:orient"].Set(Gf.Quatd(q.GetReal(), Gf.Vec3d(q.GetImaginary())))

print(f"\nCamera placed at {cam_pos}, aimed at rotor.")

# 5) Sanity check
print("\n--- Bbox containment check ---")
for name, path in [("Port_LPC_cutter/Cylinder", CYLINDER_PATH), ("rotor", f"{ROOT}/rotor")]:
    prim = stage.GetPrimAtPath(path)
    rng = bbox_cache.ComputeWorldBound(prim).ComputeAlignedRange()
    print(f"camera inside {name} bbox = {rng.Contains(cam_pos)}")

print("\nLook through Camera_001 again.")




