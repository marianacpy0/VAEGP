# setup_borescope_camera_complete.py
# Run inside Isaac Sim's Script Editor.
#
# All-in-one, safe to rerun anytime: deactivates the old referenced
# camera, creates a fresh camera rig with calibration-matched intrinsics,
# positions it just outside the rotor (pulled back from blade material,
# not into it), aims it at the rotor, and adds a tip light.
#
# IMPORTANT: after this runs clean, do File > Save As and save the stage
# to your scenes folder -- this session was never saved, which is why
# the camera rig vanished last time.

from pxr import Usd, UsdGeom, UsdLux, Gf
import omni.usd
import math

stage = omni.usd.get_context().get_stage()
ROOT = "/World/ScaledEngineWPorts"

OLD_CAMERA_GROUP = f"{ROOT}/Camera_LPC_borescope"
CAM_XFORM = "/World/BorescopeCam"
CAM_PATH = f"{CAM_XFORM}/Camera_001"
LIGHT_PATH = f"{CAM_XFORM}/TipLight"

PULLBACK = 0.02  # meters, away from the rotor. Try 0.05 / 0.1 if still stuck in geometry.

bbox_cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_])


def real_center(path):
    prim = stage.GetPrimAtPath(path)
    rng = bbox_cache.ComputeWorldBound(prim).ComputeAlignedRange()
    return Gf.Vec3d(rng.GetMidpoint())


# --- 1) Deactivate the old referenced camera ---
old_cam = stage.GetPrimAtPath(OLD_CAMERA_GROUP)
if old_cam.IsValid():
    old_cam.SetActive(False)
    print(f"Deactivated {OLD_CAMERA_GROUP}")

# --- 2) Real port + rotor positions, direction, final camera position ---
port_center = real_center(f"{ROOT}/Port_LPC_cutter")
rotor_center = real_center(f"{ROOT}/rotor")
direction = (rotor_center - port_center).GetNormalized()
cam_pos = port_center - direction * PULLBACK
print("Port real center:", port_center)
print("Rotor real center:", rotor_center)
print("Camera position:", cam_pos)

# --- 3) Build (or reuse) the camera rig ---
cam_xform = UsdGeom.Xform.Define(stage, CAM_XFORM)
cam_xform.ClearXformOpOrder()
translate_op = cam_xform.AddTranslateOp()
orient_op = cam_xform.AddOrientOp(UsdGeom.XformOp.PrecisionDouble)
cam_xform.AddScaleOp().Set(Gf.Vec3f(1, 1, 1))

translate_op.Set(cam_pos)
default_forward = Gf.Vec3d(0, 0, -1)
look_rotation = Gf.Rotation(default_forward, direction)
q = look_rotation.GetQuaternion()
orient_op.Set(Gf.Quatd(q.GetReal(), Gf.Vec3d(q.GetImaginary())))

# --- 4) Intrinsics from your calibration matrix (fx=fy=963.2, 1280x1024) ---
WIDTH_PX, HEIGHT_PX, FX = 1280, 1024, 963.2165
H_APERTURE = 1.0
V_APERTURE = H_APERTURE * (HEIGHT_PX / WIDTH_PX)
FOCAL_LENGTH = (FX / WIDTH_PX) * H_APERTURE

camera = UsdGeom.Camera.Define(stage, CAM_PATH)
camera.GetFocalLengthAttr().Set(FOCAL_LENGTH)
camera.GetHorizontalApertureAttr().Set(H_APERTURE)
camera.GetVerticalApertureAttr().Set(V_APERTURE)
camera.GetClippingRangeAttr().Set(Gf.Vec2f(0.001, 1000))

h_fov = 2 * math.degrees(math.atan((H_APERTURE / 2) / FOCAL_LENGTH))
v_fov = 2 * math.degrees(math.atan((V_APERTURE / 2) / FOCAL_LENGTH))
print(f"Camera FOV: {h_fov:.1f} x {v_fov:.1f} deg (target: 67 x 56)")

# --- 5) Tip light ---
light = UsdLux.SphereLight.Define(stage, LIGHT_PATH)
light.CreateRadiusAttr(0.004)
light.CreateIntensityAttr(15000.0)
light.CreateColorAttr(Gf.Vec3f(1.0, 0.95, 0.85))
light.CreateExposureAttr(0.0)
lxf = UsdGeom.Xformable(light.GetPrim())
lxf.ClearXformOpOrder()
lxf.AddTranslateOp().Set(Gf.Vec3d(0, 0, 0))

# --- 6) Bbox containment sanity check ---
print("\n--- Bbox containment check ---")
for name in ["Port_LPC_cutter", "rotor", "LPC_casing_patch"]:
    prim = stage.GetPrimAtPath(f"{ROOT}/{name}")
    if not prim.IsValid():
        continue
    rng = bbox_cache.ComputeWorldBound(prim).ComputeAlignedRange()
    print(f"camera inside {name} bbox = {rng.Contains(cam_pos)}")

print(f"\nDone. Select {CAM_PATH} and look through it.")
print("NOW SAVE THE STAGE (File > Save As, into your scenes folder) "
      "so this doesn't disappear again.")






