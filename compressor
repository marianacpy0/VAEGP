# find_real_port_location.py
# Run inside Isaac Sim's Script Editor.
#
# Stop trusting leftover Blender pivots (Port_LPC_cutter, LPC_probe,
# etc.) -- we already proved with shaft/bearings that an Xform's own
# origin isn't a reliable position. Instead, measure the REAL mesh
# geometry via world-space bounding boxes for every LPC/HPC-related
# part, so we can see what's actually sitting close to the rotor blades
# (that's the real port candidate) vs. what's just scattered reference
# geometry from modeling.

from pxr import Usd, UsdGeom, Gf
import omni.usd

stage = omni.usd.get_context().get_stage()
ROOT = "/World/ScaledEngineWPorts"

bbox_cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_])

CANDIDATES = [
    "rotor", "stator",
    "LPC_casing_patch", "HPC_casing_patch",
    "Port_LPC_cutter", "Port_HPC_cutter",
    "LPC_window_guide", "HPC_window_guide",
    "LPC_probe", "casing_for_port_cut",
]

results = {}
print("--- Real mesh-based world bounding boxes (not Xform pivots) ---\n")
for name in CANDIDATES:
    path = f"{ROOT}/{name}"
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid():
        print(f"{name}: not found at {path}")
        continue
    rng = bbox_cache.ComputeWorldBound(prim).ComputeAlignedRange()
    if rng.IsEmpty():
        print(f"{name}: no mesh geometry found under it (empty bbox)")
        continue
    center = rng.GetMidpoint()
    size = rng.GetSize()
    results[name] = center
    print(f"{name:20s} center={tuple(round(c, 3) for c in center)}  size={tuple(round(s, 3) for s in size)}")

if "rotor" in results:
    rotor_center = Gf.Vec3d(results["rotor"])
    print("\n--- Distance from rotor's real center to each candidate ---")
    for name, center in results.items():
        if name == "rotor":
            continue
        d = (Gf.Vec3d(center) - rotor_center).GetLength()
        print(f"rotor -> {name:20s}: {d:.3f} m")
else:
    print("\n!! rotor bbox came back empty -- can't compute distances. "
          "Check that 'rotor' actually has mesh children (expand it in "
          "the Stage panel).")




# add_tip_light.py
# Run inside Isaac Sim's Script Editor.
#
# The old Camera_LPC_borescope group likely carried its own tip light
# (mentioned in earlier project notes) -- deactivating that whole group
# switched the light off too. A real engine interior is pitch black
# without the probe's own LED, so a black frame is the physically
# correct result, not a bug. Adding a light back to the new rig, plus a
# sanity check for a second possible cause: camera embedded in geometry.

from pxr import UsdGeom, UsdLux, Gf, Usd
import omni.usd

stage = omni.usd.get_context().get_stage()

CAM_XFORM = "/World/BorescopeCam"
LIGHT_PATH = f"{CAM_XFORM}/TipLight"

# Small sphere light at the rig's own origin, so it travels with the
# camera like a real borescope's LED tip light.
light = UsdLux.SphereLight.Define(stage, LIGHT_PATH)
light.CreateRadiusAttr(0.004)                      # ~4mm, small LED-like source
light.CreateIntensityAttr(1500.0)                  # tune this in the viewport
light.CreateColorAttr(Gf.Vec3f(1.0, 0.95, 0.85))   # warm-white LED
light.CreateExposureAttr(0.0)

xf = UsdGeom.Xformable(light.GetPrim())
xf.ClearXformOpOrder()
xf.AddTranslateOp().Set(Gf.Vec3d(0, 0, 0))

print(f"Added {LIGHT_PATH}. If it's still dark, raise Intensity in the "
      f"Property panel -- try 5000, then 20000. At a ~3cm working "
      f"distance you shouldn't need much, but exact numbers depend on "
      f"RTX exposure settings.")

# --- Sanity check: is the camera sitting inside any nearby mesh's bbox? ---
cam_world = UsdGeom.Xformable(stage.GetPrimAtPath(CAM_XFORM)).ComputeLocalToWorldTransform(
    Usd.TimeCode.Default()
).ExtractTranslation()

bbox_cache = UsdGeom.BBoxCache(Usd.TimeCode.Default(), [UsdGeom.Tokens.default_])
CHECK_PATHS = [
    "/World/ScaledEngineWPorts/Port_LPC_cutter",
    "/World/ScaledEngineWPorts/LPC_casing_patch",
    "/World/ScaledEngineWPorts/rotor",
    "/World/ScaledEngineWPorts/stator",
]
print("\n--- Checking whether the camera sits inside any nearby mesh's bounding box ---")
for path in CHECK_PATHS:
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid():
        continue
    rng = bbox_cache.ComputeWorldBound(prim).ComputeAlignedRange()
    inside = rng.Contains(cam_world)
    print(f"{path}: camera inside bbox = {inside}  (min={rng.GetMin()}, max={rng.GetMax()})")





# create_own_borescope_camera.py
# Run inside Isaac Sim's Script Editor.
#
# Camera_LPC_borescope lives inside ScaledEngineWPorts, which is a
# REFERENCE -- that's why reparenting it threw "cannot remove/rename
# ancestral prim." Prims from a reference can't be restructured at the
# referencing site. So: deactivate the old camera (safe, no composition
# conflict) and build a brand new one as a plain prim under /World,
# using your real calibration numbers and the port/rotor world
# positions already measured.

from pxr import Usd, UsdGeom, Gf
import omni.usd
import math

stage = omni.usd.get_context().get_stage()
ROOT = "/World/ScaledEngineWPorts"

OLD_CAMERA_GROUP = f"{ROOT}/Camera_LPC_borescope"
PORT_PATH = f"{ROOT}/Port_LPC_cutter"
ROTOR_PATH = f"{ROOT}/rotor"

NEW_CAM_XFORM = "/World/BorescopeCam"
NEW_CAM_PATH = f"{NEW_CAM_XFORM}/Camera_001"

STANDOFF = 0.03  # meters -- push the camera forward into the port. Tune this.

# --- 1) Deactivate the old camera group instead of moving it ---
old_cam = stage.GetPrimAtPath(OLD_CAMERA_GROUP)
if old_cam.IsValid():
    old_cam.SetActive(False)
    print(f"Deactivated {OLD_CAMERA_GROUP}")
else:
    print(f"{OLD_CAMERA_GROUP} not found -- skipping deactivation")


# --- 2) Fresh port + rotor world positions ---
def world_pos(path):
    prim = stage.GetPrimAtPath(path)
    xf = UsdGeom.Xformable(prim)
    return xf.ComputeLocalToWorldTransform(Usd.TimeCode.Default()).ExtractTranslation()


port_pos = Gf.Vec3d(world_pos(PORT_PATH))
rotor_pos = Gf.Vec3d(world_pos(ROTOR_PATH))
direction = (rotor_pos - port_pos).GetNormalized()
print("Port world pos:", port_pos)
print("Rotor world pos:", rotor_pos)
print("Look direction (port -> rotor):", direction)

# --- 3) Build the new camera rig, fully ours, outside the reference ---
cam_xform = UsdGeom.Xform.Define(stage, NEW_CAM_XFORM)
cam_xform.ClearXformOpOrder()
translate_op = cam_xform.AddTranslateOp()
orient_op = cam_xform.AddOrientOp(UsdGeom.XformOp.PrecisionDouble)
cam_xform.AddScaleOp().Set(Gf.Vec3f(1, 1, 1))

# Position: at the port, nudged forward into it along the look direction
translate_op.Set(port_pos + direction * STANDOFF)

# Orientation: rotate the camera's default forward (0,0,-1) to face the rotor
default_forward = Gf.Vec3d(0, 0, -1)
look_rotation = Gf.Rotation(default_forward, direction)
q = look_rotation.GetQuaternion()
orient_op.Set(Gf.Quatd(q.GetReal(), Gf.Vec3d(q.GetImaginary())))

# --- 4) Intrinsics derived from your calibration matrix ---
# K = [963.2165, 0, 654.2045; 0, 963.0233, 515.8088; 0, 0, 1], image 1280x1024
# fx ~= fy -> square pixels, aspect = height/width = 0.8
WIDTH_PX, HEIGHT_PX = 1280, 1024
FX = 963.2165
H_APERTURE = 1.0  # arbitrary unit -- only the ratio to focal length sets the FOV
V_APERTURE = H_APERTURE * (HEIGHT_PX / WIDTH_PX)
FOCAL_LENGTH = (FX / WIDTH_PX) * H_APERTURE  # ~0.7525

if not stage.GetPrimAtPath(NEW_CAM_PATH).IsValid():
    camera = UsdGeom.Camera.Define(stage, NEW_CAM_PATH)
else:
    camera = UsdGeom.Camera(stage.GetPrimAtPath(NEW_CAM_PATH))

camera.GetFocalLengthAttr().Set(FOCAL_LENGTH)
camera.GetHorizontalApertureAttr().Set(H_APERTURE)
camera.GetVerticalApertureAttr().Set(V_APERTURE)
camera.GetClippingRangeAttr().Set(Gf.Vec2f(0.001, 1000))

h_fov = 2 * math.degrees(math.atan((H_APERTURE / 2) / FOCAL_LENGTH))
v_fov = 2 * math.degrees(math.atan((V_APERTURE / 2) / FOCAL_LENGTH))
print(f"\nNew camera created at {NEW_CAM_PATH}")
print(f"  focalLength={FOCAL_LENGTH:.4f}  hAperture={H_APERTURE}  vAperture={V_APERTURE:.3f}")
print(f"  resulting FOV: {h_fov:.1f} deg horizontal x {v_fov:.1f} deg vertical (target: 67 x 56)")
print(f"\nSelect {NEW_CAM_PATH} in the Stage panel and set it as the "
      f"active/look-through camera to preview the framing.")







# fix_borescope_camera_placement.py
# Run inside Isaac Sim's Script Editor.
#
# Root cause: Camera_LPC_borescope was never reconciled into the same
# scale/frame as the port/rotor group (camera scale ~1.0 vs port/rotor
# scale ~0.05), so it read as 48+ meters from the port instead of sitting
# inside it.
#
# Fix: create a mount Xform as a CHILD of Port_LPC_cutter (inherits the
# port's correct transform automatically, no scale math needed), move the
# camera group under it, zero its local transform, then aim it at the
# rotor using a from/to rotation (avoids Euler-order bugs entirely).

from pxr import Usd, UsdGeom, Gf
import omni.usd
import omni.kit.commands

stage = omni.usd.get_context().get_stage()
ROOT = "/World/ScaledEngineWPorts"

PORT_PATH = f"{ROOT}/Port_LPC_cutter"
CAMERA_GROUP_PATH = f"{ROOT}/Camera_LPC_borescope"
ROTOR_PATH = f"{ROOT}/rotor"
MOUNT_PATH = f"{PORT_PATH}/BorescopeMount"
STANDOFF = 0.03  # meters -- how far to push the camera forward into the port. Tune this.

port_prim = stage.GetPrimAtPath(PORT_PATH)
rotor_prim = stage.GetPrimAtPath(ROTOR_PATH)
assert port_prim.IsValid(), f"Port not found: {PORT_PATH}"
assert rotor_prim.IsValid(), f"Rotor not found: {ROTOR_PATH}"

# 1) Mount: identity-transform child of the port -- sits exactly at the
#    port's own origin/orientation, whatever that is in world space.
if not stage.GetPrimAtPath(MOUNT_PATH).IsValid():
    mount = UsdGeom.Xform.Define(stage, MOUNT_PATH)
else:
    mount = UsdGeom.Xform(stage.GetPrimAtPath(MOUNT_PATH))
mount.ClearXformOpOrder()
mount.AddTranslateOp().Set(Gf.Vec3d(0, 0, 0))
mount.AddOrientOp(UsdGeom.XformOp.PrecisionDouble).Set(Gf.Quatd(1, 0, 0, 0))
mount.AddScaleOp().Set(Gf.Vec3f(1, 1, 1))

# 2) Move the camera group under the mount. If this command name doesn't
#    exist in your Kit version, just drag Camera_LPC_borescope onto
#    BorescopeMount in the Stage panel instead, then re-run from step 3.
new_camera_group_path = f"{MOUNT_PATH}/Camera_LPC_borescope"
if not stage.GetPrimAtPath(new_camera_group_path).IsValid():
    omni.kit.commands.execute(
        "MovePrim",
        path_from=CAMERA_GROUP_PATH,
        path_to=new_camera_group_path,
        keep_world_transform=False,
    )

cam_group_prim = stage.GetPrimAtPath(new_camera_group_path)
assert cam_group_prim.IsValid(), "Reparent failed -- move it manually in the Stage panel, then rerun from here."

cam_group = UsdGeom.Xformable(cam_group_prim)
cam_group.ClearXformOpOrder()
translate_op = cam_group.AddTranslateOp()
orient_op = cam_group.AddOrientOp(UsdGeom.XformOp.PrecisionDouble)
cam_group.AddScaleOp().Set(Gf.Vec3f(1, 1, 1))
translate_op.Set(Gf.Vec3d(0, 0, 0))

# 3) Aim at the rotor: get rotor's world position, convert into the
#    mount's local space (mount now equals the port's world transform).
mount_xf = UsdGeom.Xformable(stage.GetPrimAtPath(MOUNT_PATH))
mount_world = mount_xf.ComputeLocalToWorldTransform(Usd.TimeCode.Default())
mount_world_inv = mount_world.GetInverse()

rotor_world_pos = UsdGeom.Xformable(rotor_prim).ComputeLocalToWorldTransform(
    Usd.TimeCode.Default()
).ExtractTranslation()
rotor_local = mount_world_inv.Transform(rotor_world_pos)
print("Rotor position in the port's local space:", rotor_local)

target_forward = Gf.Vec3d(rotor_local).GetNormalized()
default_forward = Gf.Vec3d(0, 0, -1)  # USD cameras look down -Z by default
look_rotation = Gf.Rotation(default_forward, target_forward)
orient_op.Set(Gf.Quatd(look_rotation.GetQuat()))

# 4) Push the camera forward into the port opening by STANDOFF meters,
#    along the same direction we just aimed it.
translate_op.Set(Gf.Vec3d(target_forward * STANDOFF))

print(f"Camera reparented to {new_camera_group_path}, aimed at rotor, "
      f"standoff={STANDOFF}m.\n"
      f"Select Camera_001 in the Stage panel and hit the 'look through "
      f"selected camera' hotkey (usually F or right-click > "
      f"'Set as active camera') to preview the framing. Tune STANDOFF "
      f"and rerun if it needs to sit deeper or shallower in the port.")





# inspect_axis_and_units.py
# Run inside Isaac Sim's Script Editor.
#
# 1) Reports the stage's meters-per-unit so "50 units away" means
#    something concrete.
# 2) Pulls world positions for the shaft + its bearings to work out the
#    compressor's real spin axis (rotor's own rotateXYZ doesn't tell us
#    that directly).
# 3) Prints ready-to-use vectors: port -> rotor (where the camera should
#    look) and camera -> port (how to move the camera rig into place).

from pxr import Usd, UsdGeom, Gf
import omni.usd

stage = omni.usd.get_context().get_stage()
ROOT = "/World/ScaledEngineWPorts"

mpu = UsdGeom.GetStageMetersPerUnit(stage)
print(f"Stage metersPerUnit: {mpu}  (1 stage unit = {mpu} m = {mpu*100} cm)")


def world_pos(path):
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid():
        print(f"  !! {path} not found")
        return None
    xf = UsdGeom.Xformable(prim)
    world = xf.ComputeLocalToWorldTransform(Usd.TimeCode.Default())
    return world.ExtractTranslation()


names = {
    "camera": f"{ROOT}/Camera_LPC_borescope",
    "probe": f"{ROOT}/LPC_probe",
    "port": f"{ROOT}/Port_LPC_cutter",
    "rotor": f"{ROOT}/rotor",
    "shaft": f"{ROOT}/shaft",
    "shaft_bearing_01": f"{ROOT}/shaft_bearing_01",
    "shaft_bearing_02": f"{ROOT}/shaft_bearing_02",
    "rotor_bearing_01": f"{ROOT}/rotor_bearing_01",
    "stator": f"{ROOT}/stator",
}

pos = {}
print("\n--- World positions ---")
for label, path in names.items():
    p = world_pos(path)
    pos[label] = p
    print(f"{label:18s} {path}: {p}")


def vec(a, b):
    if pos.get(a) is None or pos.get(b) is None:
        return None
    return Gf.Vec3d(pos[b]) - Gf.Vec3d(pos[a])


def dist(a, b):
    v = vec(a, b)
    return v.GetLength() if v else None


print("\n--- Derived distances (stage units; multiply by metersPerUnit for meters) ---")
for pair in [("camera", "probe"), ("camera", "port"), ("port", "rotor"),
             ("camera", "rotor"), ("shaft_bearing_01", "shaft_bearing_02")]:
    d = dist(*pair)
    print(f"{pair[0]:18s} -> {pair[1]:18s}: {d}")

print("\n--- Direction vectors (for aiming/moving) ---")
print("port -> rotor (look direction the camera should point):",
      vec("port", "rotor"))
print("camera -> port (how to move the camera rig into place):",
      vec("camera", "port"))
print("shaft_bearing_01 -> shaft_bearing_02 (candidate spin axis):",
      vec("shaft_bearing_01", "shaft_bearing_02"))





# inspect_camera_and_rotor.py
# Run inside Isaac Sim's Script Editor.
#
# Digs into Camera_LPC_borescope, LPC_probe, Port_LPC_cutter, and rotor
# to get real transforms + camera intrinsics, so we know what's already
# positioned correctly vs what still needs to be set for the borescope
# preview video.

from pxr import Usd, UsdGeom
import omni.usd

stage = omni.usd.get_context().get_stage()
ROOT = "/World/ScaledEngineWPorts"


def dump_prim(path, label):
    prim = stage.GetPrimAtPath(path)
    print(f"\n--- {label}: {path} ---")
    if not prim.IsValid():
        print("  !! not found")
        return
    xf = UsdGeom.Xformable(prim)
    ops = xf.GetOrderedXformOps()
    print("  xformOps:", [op.GetOpName() for op in ops])
    for op in ops:
        print(f"    {op.GetOpName()} = {op.Get()}")
    world = xf.ComputeLocalToWorldTransform(Usd.TimeCode.Default())
    print("  world translation:", world.ExtractTranslation())


def walk_children(path, indent=2):
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid():
        print(" " * indent + f"!! {path} not found")
        return
    for child in prim.GetChildren():
        print(" " * indent + f"{child.GetPath()}  [{child.GetTypeName()}]")
        walk_children(child.GetPath(), indent + 2)


print("=== Camera_LPC_borescope hierarchy ===")
walk_children(f"{ROOT}/Camera_LPC_borescope")

print("\n=== Camera prim(s) found inside it, with intrinsics ===")
cam_group = stage.GetPrimAtPath(f"{ROOT}/Camera_LPC_borescope")
if cam_group.IsValid():
    for prim in Usd.PrimRange(cam_group):
        if prim.GetTypeName() == "Camera":
            cam = UsdGeom.Camera(prim)
            print(f"Camera at {prim.GetPath()}")
            print("  focalLength:", cam.GetFocalLengthAttr().Get())
            print("  horizontalAperture:", cam.GetHorizontalApertureAttr().Get())
            print("  verticalAperture:", cam.GetVerticalApertureAttr().Get())
            print("  clippingRange:", cam.GetClippingRangeAttr().Get())

dump_prim(f"{ROOT}/Camera_LPC_borescope", "Camera_LPC_borescope (group)")
dump_prim(f"{ROOT}/LPC_probe", "LPC_probe")
dump_prim(f"{ROOT}/LPC_probe/Cylinder_002", "LPC_probe/Cylinder_002 mesh")
dump_prim(f"{ROOT}/Port_LPC_cutter", "Port_LPC_cutter")
dump_prim(f"{ROOT}/rotor", "rotor")

# What camera is the viewport currently rendering with (handy to confirm
# whether Camera_LPC_borescope is even wired up as a usable camera yet)
try:
    from omni.kit.viewport.utility import get_active_viewport
    vp = get_active_viewport()
    print("\nActive viewport camera path:", vp.camera_path)
except Exception as e:
    print("\nCouldn't read active viewport camera:", e)
