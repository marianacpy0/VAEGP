def load_model():
    if SOURCE == "accel":
        import accel_profile
        importlib.reload(accel_profile)
        kin = accel_profile.AccelKinematics(sigma=NECK_LENGTH_MM / 1000.0, l=CAMERA_LENGTH_MM / 1000.0)
        return accel_profile, {}, kin
    spec = importlib.util.spec_from_file_location("spatial_borescope_model", MODEL_PY)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    if hasattr(mod, "motion_profile"):
        mod.motion_profile = PROFILE
    # the model script starts its own viewer animation when loaded: switch it off (it writes the stage every frame)
    if hasattr(mod, "stop_animation"):
        mod.stop_animation = True
    for name in dir(mod):
        if "sub" in name.lower() and not name.startswith("__") and not callable(getattr(mod, name)):
            setattr(mod, name, None)
    bounds = mod.resolve_motion_profile(PROFILE)
    for make in (lambda: mod.BorescopeKinematics(bounds), lambda: mod.BorescopeKinematics(**bounds),
                 lambda: mod.BorescopeKinematics(PROFILE)):
        try:
            return mod, bounds, make()
        except TypeError:
            pass
    raise TypeError("Could not create BorescopeKinematics: change the 3 calls in load_model().")


def unit(v):
    n = np.linalg.norm(v)
    return v / n if n > 1e-12 else v


def Rx(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[1, 0, 0], [0, c, -s], [0, s, c]])


def Ry(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, 0, s], [0, 1, 0], [-s, 0, c]])


def Rz(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, -s, 0], [s, c, 0], [0, 0, 1]])


def resample(P, n):
    s = np.r_[0.0, np.cumsum(np.linalg.norm(np.diff(P, axis=0), axis=1))]
    u = np.linspace(0.0, s[-1], n + 1)
    return np.stack([np.interp(u, s, P[:, k]) for k in range(3)], 1)


def tilt_angles(d, F):
    """X-then-Z revolute angles that turn frame F so its +Y axis points along d. Returns (a, b, new F)."""
    t = F.T @ d
    b = -math.asin(float(np.clip(t[0], -1, 1)))
    a = math.atan2(t[2], t[1])
    return a, b, F @ Rx(a) @ Rz(b)


def joint_targets(arc, start, neck_end, cam, roll):
    """Pivot angles at the port, push length, and the neck joint angles that put every neck link along the
    model's arc and the head on the model's camera. Solved link by link in the actual parent frame."""
    A = np.asarray(arc, float)
    T0 = unit(-3 * A[0] + 4 * A[1] - A[2])            # neck start tangent
    u = unit(start) if np.linalg.norm(start) > 2e-3 else T0   # tube direction: port -> neck start
    pa, pb, F = tilt_angles(u, np.eye(3))
    lam = float(np.dot(start, u))
    F = F @ Ry(roll)
    pts = resample(A, NECK_SEGMENTS)
    dirs = [unit(b - a) for a, b in zip(pts[:-1], pts[1:])] + [unit(cam - neck_end)]
    neck = []
    for d in dirs:
        a, b, F = tilt_angles(d, F)
        neck.append((a, b))
    kink = math.degrees(math.acos(float(np.clip(np.dot(u, T0), -1, 1))))
    off = float(np.linalg.norm(np.cross(start, u)))
    return (pa, pb), lam, neck, kink, off


def model_targets(bounds, kin):
    t = np.asarray(kin.simulation_time_seconds, float)
    start = np.asarray(kin.neck_translation_position_meters, float)
    arcs = np.asarray(kin.probe_sector_points_meters, float)
    necks = np.asarray(kin.neck_position_meters, float)
    cams = np.asarray(kin.camera_position_meters, float)
    # roll follows the same time law as the insertion (recovered from the insertion length)
    if hasattr(kin, "roll_rad"):                      # accel_profile: beta(t) comes from the integration
        roll = np.asarray(kin.roll_rad, float)
    else:
        lam_n = np.linalg.norm(start, axis=1)
        l0, l1 = bounds["initial_y_translation_meters"], bounds["final_y_translation_meters"]
        s = np.clip((lam_n - l0) / (l1 - l0), 0, 1) if abs(l1 - l0) > 1e-12 else np.zeros_like(lam_n)
        r0, r1 = bounds["initial_roll_angle_rad"], bounds["final_roll_angle_rad"]
        roll = r0 + (r1 - r0) * s
    R = [joint_targets(arcs[i], start[i], necks[i], cams[i], roll[i]) for i in range(len(t))]
    return dict(t=t, roll=roll, pivot=np.array([r[0] for r in R]), lam=np.array([r[1] for r in R]),
                neck=np.array([r[2] for r in R]), kink=np.array([r[3] for r in R]),
                off=np.array([r[4] for r in R]), necks=necks, cams=cams)


