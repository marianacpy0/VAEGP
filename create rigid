"""
create_rigid_probe.py

Builds the probe as: KINEMATIC rigid shaft (insertion tube) + rigid
articulated bending neck at the tip. No deformable body here -- see
create_deformable_connector.py for the cable piece.

All tunable numbers live in probe_config.py -- edit values there, not
in this file.

This script DELETES old /World/Cable, /World/Cube, /World/BendingNeck,
and /World/Shaft prims first, then builds everything fresh. Run it once,
in Play or Stop -- it doesn't need live simulation since nothing here is
deformable.
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath(__file__)))

from pxr import Usd, UsdGeom, UsdPhysics, PhysxSchema, Gf
import omni.usd
import probe_config as cfg

OLD_PRIM_PATHS_TO_DELETE = ["/World/Cable", "/World/Cube", "/World/BendingNeck", "/World/Shaft"]


def get_stage():
    return omni.usd.get_context().get_stage()


def delete_old_prims(stage):
    for path in OLD_PRIM_PATHS_TO_DELETE:
        prim = stage.GetPrimAtPath(path)
        if prim.IsValid():
            stage.RemovePrim(path)
            print(f"Deleted old prim: {path}")


def compute_shaft_direction_and_base():
    """Reconstructs the shaft's direction/base position from the Euler
    angles and center reference stored in probe_config.py."""
    rx, ry, rz = cfg.SHAFT_ORIENT_EULER_XYZ_DEG
    rotation = (
        Gf.Rotation(Gf.Vec3d(1, 0, 0), rx)
        * Gf.Rotation(Gf.Vec3d(0, 1, 0), ry)
        * Gf.Rotation(Gf.Vec3d(0, 0, 1), rz)
    )
    direction = rotation.TransformDir(Gf.Vec3d(0, 0, 1))
    base_position = cfg.SHAFT_CENTER_REFERENCE - Gf.Vec3d(direction).GetNormalized() * (cfg.SHAFT_LENGTH / 2.0)
    return direction, base_position


def create_kinematic_shaft(stage, path, base_position, direction, radius, length):
    """
    Creates the rigid insertion tube as a KINEMATIC rigid body.

    Kinematic means: still does NOT react to gravity or forces (matches
    the real device's rigidity), but unlike a plain static mesh, it CAN
    be moved/dragged -- including live, during Play -- and PhysX will
    correctly drag along anything properly jointed to it.
    """
    direction = Gf.Vec3d(direction).GetNormalized()
    center_position = base_position + direction * (length / 2.0)

    cylinder = UsdGeom.Cylinder.Define(stage, path)
    cylinder.CreateRadiusAttr(radius)
    cylinder.CreateHeightAttr(length)

    default_axis = Gf.Vec3d(0, 0, 1)
    xform = UsdGeom.Xformable(cylinder.GetPrim())
    xform.AddTranslateOp().Set(center_position)
    if not Gf.IsClose(default_axis, direction, 1e-6):
        rotation = Gf.Rotation(default_axis, direction)
        xform.AddOrientOp().Set(Gf.Quatf(rotation.GetQuat()))

    rigid_body = UsdPhysics.RigidBodyAPI.Apply(cylinder.GetPrim())
    rigid_body.CreateKinematicEnabledAttr(True)
    UsdPhysics.CollisionAPI.Apply(cylinder.GetPrim())

    tip_position = base_position + direction * length
    return cylinder.GetPrim(), tip_position


def create_rigid_segment(stage, path, position, radius, length, direction):
    """Rotates the cylinder to align with `direction` instead of sitting
    in its default orientation."""
    cylinder = UsdGeom.Cylinder.Define(stage, path)
    cylinder.CreateRadiusAttr(radius)
    cylinder.CreateHeightAttr(length)

    default_axis = Gf.Vec3d(0, 0, 1)
    target_direction = Gf.Vec3d(direction).GetNormalized()

    xform = UsdGeom.Xformable(cylinder.GetPrim())
    xform.AddTranslateOp().Set(Gf.Vec3d(position))
    if not Gf.IsClose(default_axis, target_direction, 1e-6):
        rotation = Gf.Rotation(default_axis, target_direction)
        xform.AddOrientOp().Set(Gf.Quatf(rotation.GetQuat()))

    UsdPhysics.RigidBodyAPI.Apply(cylinder.GetPrim())
    UsdPhysics.CollisionAPI.Apply(cylinder.GetPrim())

    # Mass must be explicit and non-zero -- MassAPI without a set mass/
    # density silently defaults to 0.0, a degenerate case for the solver
    # (F=ma breaks down when m=0), which caused violent uncontrolled
    # collapse independent of gravity.
    mass_api = UsdPhysics.MassAPI.Apply(cylinder.GetPrim())
    mass_api.CreateDensityAttr().Set(cfg.NECK_SEGMENT_DENSITY)

    # Disable gravity on the neck segments -- matches the real device
    # (cable-driven tip holds its commanded position, doesn't sag).
    physx_rigid_body = PhysxSchema.PhysxRigidBodyAPI.Apply(cylinder.GetPrim())
    physx_rigid_body.CreateDisableGravityAttr(True)
    return cylinder.GetPrim()


def create_d6_joint_with_drive(stage, joint_path, body0_path, body1_path,
                                 stiffness, damping, angle_limit_deg,
                                 body0_offset, body1_offset):
    """
    Locks translation and anchors the joint at each body's actual
    touching end-face (not its center) -- only rotation on the two
    bending axes (rotX/rotY) stays free; twist (rotZ) is locked too.

    body0_offset / body1_offset: the Z offset, in EACH body's own local
    frame, where the joint connects -- separate parameters since body0
    and body1 aren't always the same size (e.g. shaft vs. neck segment
    for the first joint).
    """
    joint = UsdPhysics.Joint.Define(stage, joint_path)
    joint.CreateBody0Rel().SetTargets([body0_path])
    joint.CreateBody1Rel().SetTargets([body1_path])

    joint.CreateLocalPos0Attr().Set(Gf.Vec3f(0.0, 0.0, body0_offset))
    joint.CreateLocalPos1Attr().Set(Gf.Vec3f(0.0, 0.0, body1_offset))

    for axis in ("transX", "transY", "transZ"):
        lock = UsdPhysics.LimitAPI.Apply(joint.GetPrim(), axis)
        lock.CreateLowAttr(0.0)
        lock.CreateHighAttr(0.0)

    twist_lock = UsdPhysics.LimitAPI.Apply(joint.GetPrim(), "rotZ")
    twist_lock.CreateLowAttr(0.0)
    twist_lock.CreateHighAttr(0.0)

    for axis in ("rotX", "rotY"):
        bend_limit = UsdPhysics.LimitAPI.Apply(joint.GetPrim(), axis)
        bend_limit.CreateLowAttr(-angle_limit_deg)
        bend_limit.CreateHighAttr(angle_limit_deg)

        drive = UsdPhysics.DriveAPI.Apply(joint.GetPrim(), axis)
        drive.CreateTypeAttr("force")
        drive.CreateStiffnessAttr(stiffness)
        drive.CreateDampingAttr(damping)
        # Explicit targetPosition/maxForce -- without these the drive may
        # not actually engage, leaving the joint effectively unconstrained.
        drive.CreateTargetPositionAttr().Set(0.0)   # rest = straight
        drive.CreateTargetVelocityAttr().Set(0.0)
        drive.CreateMaxForceAttr().Set(1.0e6)

    return joint.GetPrim()


def build_probe():
    stage = get_stage()

    delete_old_prims(stage)

    direction, base_position = compute_shaft_direction_and_base()

    shaft_prim, tip_position = create_kinematic_shaft(
        stage, cfg.SHAFT_PRIM_PATH, base_position, direction, cfg.PROBE_RADIUS, cfg.SHAFT_LENGTH
    )
    print(f"Kinematic shaft created, tip at: {tip_position}")

    direction = Gf.Vec3d(direction).GetNormalized()

    segment_paths = []
    prev_path = None

    for i in range(cfg.NUM_NECK_SEGMENTS):
        offset = direction * (cfg.SEGMENT_LENGTH * i)
        position = tip_position + offset
        seg_path = f"{cfg.NECK_ROOT_PATH}/segment_{i}"

        create_rigid_segment(stage, seg_path, position, cfg.PROBE_RADIUS, cfg.SEGMENT_LENGTH, direction)
        segment_paths.append(seg_path)

        if prev_path is None:
            joint_path = f"{cfg.NECK_ROOT_PATH}/joint_shaft_0"
            create_d6_joint_with_drive(
                stage, joint_path, cfg.SHAFT_PRIM_PATH, seg_path,
                cfg.JOINT_DRIVE_STIFFNESS, cfg.JOINT_DRIVE_DAMPING, cfg.JOINT_ANGLE_LIMIT_DEG,
                body0_offset=cfg.SHAFT_LENGTH / 2.0, body1_offset=-cfg.SEGMENT_LENGTH / 2.0
            )
        else:
            joint_path = f"{cfg.NECK_ROOT_PATH}/joint_{i-1}_{i}"
            create_d6_joint_with_drive(
                stage, joint_path, prev_path, seg_path,
                cfg.JOINT_DRIVE_STIFFNESS, cfg.JOINT_DRIVE_DAMPING, cfg.JOINT_ANGLE_LIMIT_DEG,
                body0_offset=cfg.SEGMENT_LENGTH / 2.0, body1_offset=-cfg.SEGMENT_LENGTH / 2.0
            )

        prev_path = seg_path

    print(f"Bending neck built: {cfg.NUM_NECK_SEGMENTS} segments under {cfg.NECK_ROOT_PATH}")
    print("Shaft is kinematic -- move/drag it (even during Play) and the neck will follow.")


if __name__ == "__main__":
    build_probe()
