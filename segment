    cable_root = build_deformable_cable(
        stage, "/World/Cable", cable_center, direction, CABLE_RADIUS, CABLE_LENGTH,
        "/World/Looks/CableMaterial", youngs_modulus=3.1e8, damping=0.05,
    )
    if cable_root is None:
        print("STOP -- cable failed to build.")
        return

    print("\n--- Attachment: Anchor -> Cable (proven manual method) ---")
    held = attach_deformable_to_rigid(
        stage, "/World/attachment_anchor_to_cable", str(cable_root.GetPath()), "/World/Cable/SimMesh",
        "/World/Anchor", rigid_local_radius=ANCHOR_RADIUS, rigid_local_half_length=ANCHOR_LENGTH / 2.0,
    )

    print(f"\n{'READY -- captured real vertices, safe to Play.' if held else 'DO NOT PLAY -- nothing captured, tell me the numbers above.'}")


if __name__ == "__main__":
    run_build()







