"""
accel_profile.py - borescope kinematics driven by acceleration.  Plain Python (numpy), also used by port_probe.py.

    input : mu_ddot(t) = [theta_ddot, alpha_ddot, lambda_ddot, beta_ddot]   (rad/s^2, m/s^2)
    state : mu = [theta, alpha, lambda, beta],  mu_dot
    output: r(t) = h1(p, mu(t)) -> neck start, neck arc, neck end, camera   (port frame, metres)

Integration is exact for an acceleration held constant over each step (double integrator):
    mu_dot[k+1] = mu_dot[k] + dt * u[k]
    mu[k+1]     = mu[k] + dt * mu_dot[k] + 0.5 * dt^2 * u[k]
Box constraints on mu, mu_dot and mu_ddot (ACCEL_BOUNDS in the config) are enforced every step and logged.
A position bound acts as a hard stop (velocity set to zero), logged as "position limit reached, clipped".

Conventions:
    frame : origin at the inspection port, +Y = insertion, +Z = up, X = Y x Z
    theta : theta = pi - sigma/rho, so theta = pi is a straight neck (bend angle phi = pi - theta)
    alpha : rotation of the bending plane about +Y; alpha = 0 bends toward +Z
    lambda: unsupported length, port -> start of the neck, along +Y
    beta  : roll of the probe about +Y
h1 is either the kinematic model (model_fk, ACCEL_H1 = "model") or the built-in constant-curvature
forward_kinematics() below (ACCEL_H1 = "builtin").

Use in Python:
    import accel_profile as A
    kin = A.AccelKinematics(A.EXAMPLE_SEGMENTS)       # list of (duration, [4 accelerations]) or a function u(t)
    kin.camera_position_meters                        # (N, 3)
"""
import math
import numpy as np

import borescope_config as C   # settings: ACCEL_DT, ACCEL_BOUNDS, NECK_MM, HEAD_MM

# =============================================================================
# SETTINGS (from borescope_config.py, converted to metres / radians)
# =============================================================================
SIGMA_M = C.NECK_MM / 1000.0   # bending neck length sigma
L_M     = C.HEAD_MM / 1000.0   # neck end -> camera, l
DT      = C.ACCEL_DT           # integration / output step [s]
N_ARC   = 25                   # points along the neck arc
EPS     = 1e-9                 # tolerance before a bound counts as hit

MU0     = [math.pi, 0.0, 0.0, 0.0]     # initial [theta, alpha, lambda, beta]: straight neck at the port
MU0_DOT = [0.0, 0.0, 0.0, 0.0]         # initial velocities

# Box constraints: (lower, upper) for each of theta, alpha, lambda, beta, in rad / m (config is in deg / mm)
_SI = (math.radians(1.0), math.radians(1.0), 1e-3, math.radians(1.0))
BOUNDS = {k: [(lo * f, hi * f) for (lo, hi), f in zip(v, _SI)] for k, v in C.ACCEL_BOUNDS.items()}

# Acceleration profile: list of (duration_s, [theta_ddot, alpha_ddot, lambda_ddot, beta_ddot]),
# each held constant for its duration. Accelerate then brake with the same value -> moves and stops.
# (theta_ddot < 0 bends the neck, because theta = pi is straight.)
EXAMPLE_SEGMENTS = [
    (0.5, [0.0, 0.0, 0.0, 0.0]),          # hold
    (1.0, [0.0, 0.0, 0.05, 0.0]),         # push in: speed up to 50 mm/s ...
    (0.8, [0.0, 0.0, 0.0, 0.0]),          # ... keep going ...
    (1.0, [0.0, 0.0, -0.05, 0.0]),        # ... and brake        -> +90 mm
    (1.0, [-0.5, 0.0, 0.0, 0.0]),         # bend the neck ...
    (1.0, [0.5, 0.0, 0.0, 0.0]),          # ... and stop         -> 0.5 rad (29 deg) of bend
    (1.0, [0.0, 0.8, 0.0, 0.0]),          # swing the bending plane ...
    (1.0, [0.0, -0.8, 0.0, 0.0]),         # ... and stop         -> alpha 0.8 rad (46 deg)
    (1.0, [0.0, 0.0, 0.0, 0.6]),          # roll the probe ...
    (1.0, [0.0, 0.0, 0.0, -0.6]),         # ... and stop         -> beta 0.6 rad (34 deg)
    (0.5, [0.0, 0.0, 0.0, 0.0]),          # hold
]


# =============================================================================
# h1, built-in: constant-curvature neck (used when ACCEL_H1 = "builtin")
# =============================================================================
def forward_kinematics(mu, sigma=SIGMA_M, l=L_M, n_arc=N_ARC):
    """mu = [theta, alpha, lambda, beta] -> dict(start, arc (n_arc,3), neck_end, camera, tangent, up), port frame."""
    theta, alpha, lam, beta = (float(v) for v in mu)
    phi = math.pi - theta                                   # bend angle = sigma / rho
    Y = np.array([0.0, 1.0, 0.0])
    N = np.array([math.sin(alpha), 0.0, math.cos(alpha)])  # bending direction: +Z turned by alpha about +Y
    start = lam * Y
    s = np.linspace(0.0, sigma, n_arc)
    if abs(phi) < 1e-9:                                     # straight neck
        arc = start + s[:, None] * Y
        T = Y
    else:
        k = phi / sigma                                     # curvature 1/rho
        arc = start + (np.sin(k * s) / k)[:, None] * Y + ((1 - np.cos(k * s)) / k)[:, None] * N
        T = math.cos(phi) * Y + math.sin(phi) * N           # tangent at the neck end
    neck_end = arc[-1]
    camera = neck_end + l * T
    # camera "up" before roll = the bending direction turned with the neck, then rolled by beta about T
    U = -math.sin(phi) * Y + math.cos(phi) * N
    U = U * math.cos(beta) + np.cross(T, U) * math.sin(beta) + T * np.dot(T, U) * (1 - math.cos(beta))
    return dict(start=start, arc=arc, neck_end=neck_end, camera=camera, tangent=T, up=U)


# =============================================================================
# acceleration -> mu(t) (double integrator with box constraints)
# =============================================================================
def integrate(accel, t_end=None, dt=DT, mu0=MU0, mu0_dot=MU0_DOT, bounds=BOUNDS):
    """accel: list of (duration, [4 accelerations]) OR a function u(t) -> 4 accelerations (then give t_end).
    Returns t (N,), mu (N,4), mu_dot (N,4), mu_ddot (N,4), log (list of constraint events)."""
    if callable(accel):
        if t_end is None:
            raise ValueError("give t_end when accel is a function")
        u_of_t = accel
    else:
        ends = np.cumsum([d for d, _ in accel])
        vals = [np.asarray(a, float) for _, a in accel]
        t_end = float(ends[-1])
        u_of_t = lambda t: vals[min(int(np.searchsorted(ends, t + 1e-12, side="right")), len(vals) - 1)]
    lo = {k: np.array([b[0] for b in v]) for k, v in bounds.items()}
    hi = {k: np.array([b[1] for b in v]) for k, v in bounds.items()}
    n = int(round(t_end / dt))
    t = np.arange(n + 1) * dt
    mu = np.zeros((n + 1, 4))
    md = np.zeros((n + 1, 4))
    mdd = np.zeros((n + 1, 4))
    mu[0], md[0] = np.asarray(mu0, float), np.asarray(mu0_dot, float)
    names = ("theta", "alpha", "lambda", "beta")
    log, hit = [], set()

    def note(kind, i, k, tk):
        if (kind, i) not in hit:
            hit.add((kind, i))
            log.append(f"t={tk:6.2f}s  {names[i]}: {kind} limit reached, clipped")

    for k in range(n):
        u = np.asarray(u_of_t(t[k]), float).copy()
        for i in range(4):                                   # acceleration bounds
            if u[i] < lo["mu_ddot"][i] - EPS or u[i] > hi["mu_ddot"][i] + EPS:
                note("acceleration", i, k, t[k])
        u = np.clip(u, lo["mu_ddot"], hi["mu_ddot"])
        v = md[k] + dt * u
        for i in range(4):                                   # velocity bounds -> reduce the acceleration
            if v[i] < lo["mu_dot"][i] - EPS or v[i] > hi["mu_dot"][i] + EPS:
                note("velocity", i, k, t[k])
                v[i] = np.clip(v[i], lo["mu_dot"][i], hi["mu_dot"][i])
                u[i] = (v[i] - md[k][i]) / dt
        x = mu[k] + dt * md[k] + 0.5 * dt * dt * u
        for i in range(4):                                   # position bounds -> stop there
            if x[i] < lo["mu"][i] - EPS or x[i] > hi["mu"][i] + EPS:
                note("position", i, k, t[k])
                x[i] = np.clip(x[i], lo["mu"][i], hi["mu"][i])
                v[i] = 0.0
                u[i] = (v[i] - md[k][i]) / dt
        mu[k + 1], md[k + 1], mdd[k] = x, v, u
    mdd[-1] = mdd[-2] if n > 0 else 0.0
    return t, mu, md, mdd, log


# =============================================================================
# the object port_probe.py reads (same attribute names as the kinematic model's BorescopeKinematics)
# =============================================================================
class AccelKinematics:
    def __init__(self, accel=EXAMPLE_SEGMENTS, t_end=None, dt=DT, mu0=MU0, mu0_dot=MU0_DOT, bounds=BOUNDS,
                 sigma=SIGMA_M, l=L_M, verbose=True, fk=None, fk_samples=200):
        t, mu, md, mdd, log = integrate(accel, t_end, dt, mu0, mu0_dot, bounds)
        if fk is None:                                       # this file's h1
            fk = [forward_kinematics(m, sigma, l) for m in mu]
        else:                                                # kinematic model's h1: subsample, then interpolate
            import time
            idx = np.unique(np.linspace(0, len(t) - 1, min(len(t), fk_samples)).astype(int))
            t0 = time.time()
            sub = [fk(mu[i]) for i in idx]
            if verbose:
                print(f"[accel] h1 = kinematic model, evaluated at {len(idx)} points ({time.time() - t0:.1f} s)")
            fk = _interp_fk(t, idx, sub)
        self.simulation_time_seconds = t
        self.mu, self.mu_dot, self.mu_ddot = mu, md, mdd
        self.roll_rad = mu[:, 3]
        self.neck_translation_position_meters = np.array([f["start"] for f in fk])
        self.probe_sector_points_meters = np.array([f["arc"] for f in fk])
        self.neck_position_meters = np.array([f["neck_end"] for f in fk])
        self.camera_position_meters = np.array([f["camera"] for f in fk])
        self.camera_axis = np.array([f["tangent"] for f in fk])
        self.camera_up = np.array([f["up"] for f in fk])
        self.constraint_log = log
        if verbose:
            self.summary()

    def summary(self):
        t, mu = self.simulation_time_seconds, self.mu
        print(f"[accel] {len(t)} samples, {t[-1]:.2f} s, dt {t[1] - t[0]:.3f} s")
        print(f"[accel] start mu  theta {math.degrees(mu[0, 0]):6.1f} deg  alpha {math.degrees(mu[0, 1]):6.1f} deg  "
              f"lambda {mu[0, 2] * 1000:6.1f} mm  beta {math.degrees(mu[0, 3]):6.1f} deg")
        print(f"[accel] final mu  theta {math.degrees(mu[-1, 0]):6.1f} deg  alpha {math.degrees(mu[-1, 1]):6.1f} deg  "
              f"lambda {mu[-1, 2] * 1000:6.1f} mm  beta {math.degrees(mu[-1, 3]):6.1f} deg")
        print(f"[accel] camera final (port frame) {np.round(self.camera_position_meters[-1] * 1000, 1).tolist()} mm")
        for line in self.constraint_log or ["no box constraint was hit"]:
            print("[accel]", line)


# =============================================================================
# accelerations that follow the kinematic model's profile
# =============================================================================
def profile_accel(bounds, duration, limits=BOUNDS, dt=DT):
    """ACCEL_PATH = "straight": accelerations from a profile's initial_ mu to its final_ mu, all four on the same
    smooth time law s(t) = 10 t^3 - 15 t^4 + 6 t^5 (zero speed and acceleration at both ends), i.e. a straight line
    in mu. Matches the profile's path only if the profile moves the four together (port_probe prints the difference).
    The duration is stretched if the speed or acceleration limits in BOUNDS would be hit (they would bend the path).
    Returns (accel function u(t), duration, mu0)."""
    mu0 = np.array([bounds["initial_" + k] for k in MODEL_KEYS], float)
    d = np.array([bounds["final_" + k] for k in MODEL_KEYS], float) - mu0
    vmax = np.array([min(-lo, hi) for lo, hi in limits["mu_dot"]])
    amax = np.array([min(-lo, hi) for lo, hi in limits["mu_ddot"]])
    T_min = float(max(np.max(1.875 * np.abs(d) / vmax), np.max(np.sqrt(5.7735 * np.abs(d) / amax))))
    T = max(float(duration), 1.02 * T_min)
    if T > duration + 1e-9:
        print(f"[accel] profile stretched {duration:.2f} s -> {T:.2f} s to stay inside the speed/acceleration limits")

    def u(t):
        x = min(max((t + 0.5 * dt) / T, 0.0), 1.0)      # mid-step value: integrate() holds u over [t, t + dt]
        return d * (60 * x - 180 * x * x + 120 * x ** 3) / T ** 2
    return u, T, mu0


def recover_profile_mu(fk, ref, bounds, verbose=True):
    """ACCEL_PATH = "profile": mu(t) of the kinematic model's profile, recovered from its positions. At every sample
    it finds the mu whose h1 (fk = model_fk) gives the same neck start, neck end and camera (damped Gauss-Newton,
    warm-started from the previous sample). alpha is only observable while the neck is bent; where it is straight,
    alpha is interpolated from the bent samples.
    If the positions do not depend on beta (roll), beta follows the insertion: beta0 + (beta1-beta0) * progress.
    Returns t (N,), mu (N, 4)."""
    import time
    t = np.asarray(ref.simulation_time_seconds, float)
    tgt = np.hstack([np.asarray(getattr(ref, k), float) for k in
                     ("neck_translation_position_meters", "neck_position_meters", "camera_position_meters")])
    mu0 = np.array([bounds["initial_" + k] for k in MODEL_KEYS], float)
    mu1 = np.array([bounds["final_" + k] for k in MODEL_KEYS], float)
    F = lambda m: np.hstack([(f := fk(m))["start"], f["neck_end"], f["camera"]])
    test = mu1.copy()
    test[0] = test[0] if abs(test[0] - math.pi) > 0.05 else math.pi - 0.3      # bent, so roll could show
    free = [0, 1, 2] + ([3] if np.abs(F(test + [0, 0, 0, 0.2]) - F(test)).max() > 1e-6 else [])
    eps = np.array([1e-6, 1e-6, 1e-7, 1e-6])
    t0, mu, out, worst = time.time(), mu0.copy(), [], 0.0
    for i in range(len(t)):
        for _ in range(12):
            r = F(mu) - tgt[i]
            if np.abs(r).max() < 1e-7:
                break
            J = np.stack([(F(mu + eps[j] * np.eye(4)[j]) - F(mu)) / eps[j] for j in free], 1)
            A = J.T @ J
            dx = np.linalg.solve(A + (1e-9 + 1e-6 * np.trace(A) / len(free)) * np.eye(len(free)), -J.T @ r)
            mu[free] += dx
        worst = max(worst, float(np.abs(F(mu) - tgt[i]).max()))
        out.append(mu.copy())
    mu = np.array(out)
    seen = np.abs(mu[:, 0] - math.pi) > 0.02          # alpha only shows when the neck is bent: where it is (almost)
    if seen.any() and not seen.all():                 # straight, take it smoothly from the bent samples
        mu[~seen, 1] = np.interp(t[~seen], t[seen], mu[seen, 1])
    if 3 not in free:                                     # roll does not move any point: follow the insertion
        d = mu1[2] - mu0[2]
        s = np.clip((mu[:, 2] - mu0[2]) / d, 0, 1) if abs(d) > 1e-12 else (t - t[0]) / (t[-1] - t[0])
        mu[:, 3] = mu0[3] + (mu1[3] - mu0[3]) * s
    if verbose:
        print(f"[accel] profile mu(t) recovered at {len(t)} samples ({time.time() - t0:.1f} s), "
              f"worst position mismatch {worst * 1000:.4f} mm" + ("" if 3 in free else
              " (roll is not visible in the positions: it follows the insertion)"))
    return t, mu


def _clamped_spline(x, y, d0, d1):
    """Cubic spline through (x, y) with end slopes d0, d1 -> second derivatives at the knots."""
    n, h = len(x), np.diff(x)
    A, r = np.zeros((n, n)), np.zeros(n)
    A[0, :2], r[0] = (2 * h[0], h[0]), 6 * ((y[1] - y[0]) / h[0] - d0)
    A[-1, -2:], r[-1] = (h[-1], 2 * h[-1]), 6 * (d1 - (y[-1] - y[-2]) / h[-1])
    for i in range(1, n - 1):
        A[i, i - 1:i + 2] = (h[i - 1], 2 * (h[i - 1] + h[i]), h[i])
        r[i] = 6 * ((y[i + 1] - y[i]) / h[i] - (y[i] - y[i - 1]) / h[i - 1])
    return np.linalg.solve(A, r)


def samples_accel(t, mu, limits=BOUNDS, dt=DT):
    """mu sampled at t (N, 4) -> accelerations whose integral passes through every sample: a cubic spline per
    component (starting and ending at rest), its second derivative is the acceleration. Time is stretched
    uniformly if the speed/acceleration limits would be hit (same path, slower). Returns (u(t), duration, mu0, mu0_dot)."""
    t = np.asarray(t, float) - t[0]
    M = np.stack([_clamped_spline(t, mu[:, k], 0.0, 0.0) for k in range(4)], 1)       # (N, 4)

    def ev(x):                                          # spline value / slope / second derivative at time x
        i = int(np.clip(np.searchsorted(t, x, side="right") - 1, 0, len(t) - 2))
        h, a, b = t[i + 1] - t[i], t[i + 1] - x, x - t[i]
        acc = (M[i] * a + M[i + 1] * b) / h
        vel = (-M[i] * a * a + M[i + 1] * b * b) / (2 * h) + (mu[i + 1] - mu[i]) / h - (M[i + 1] - M[i]) * h / 6
        return vel, acc
    xs = np.linspace(0, t[-1], 2000)
    V = np.abs(np.array([ev(x)[0] for x in xs])).max(0)
    Acc = np.abs(np.array([ev(x)[1] for x in xs])).max(0)
    vmax = np.array([min(-lo, hi) for lo, hi in limits["mu_dot"]])
    amax = np.array([min(-lo, hi) for lo, hi in limits["mu_ddot"]])
    k = max(1.0, float(np.max(V / vmax)), float(np.sqrt(np.max(Acc / amax))))
    k = 1.0 if k == 1.0 else 1.02 * k
    if k > 1.0:
        print(f"[accel] profile stretched {t[-1]:.2f} s -> {k * t[-1]:.2f} s to stay inside the speed/acceleration limits")
    u = lambda tt: ev(min(max((tt + 0.5 * dt) / k, 0.0), t[-1]))[1] / (k * k)   # mid-step value
    return u, k * t[-1], mu[0].copy(), ev(0.0)[0] / k


def _interp_fk(t, idx, sub):
    """Linear interpolation in time of h1 outputs evaluated at t[idx] -> one dict per t."""
    out = {}
    for k in sub[0]:
        A = np.stack([np.asarray(f[k], float) for f in sub])            # (n_sub, ...)
        flat = A.reshape(len(idx), -1)
        full = np.stack([np.interp(t, t[idx], flat[:, c]) for c in range(flat.shape[1])], 1)
        out[k] = full.reshape((len(t),) + A.shape[1:])
    return [{k: out[k][j] for k in out} for j in range(len(t))]


# =============================================================================
# the kinematic model as h1: mu -> its neck start, arc, neck end, camera
# =============================================================================
MODEL_KEYS = ("bending_angle_rad",            # theta  (pi = straight)
              "borescope_axis_rotation_rad",  # alpha
              "y_translation_meters",         # lambda
              "roll_angle_rad")               # beta


def model_fk(mod, template):
    """h1 of the kinematic model: builds its BorescopeKinematics with a CONSTANT profile (initial = final = mu) and
    returns its first sample. template = the profile's bounds dict (keeps its other settings). The model only
    evaluates whole trajectories, so each call computes a full (constant) trajectory and reads sample 0."""
    def make(b):
        for f in (lambda: mod.BorescopeKinematics(b), lambda: mod.BorescopeKinematics(**b)):
            try:
                return f()
            except TypeError:
                pass
        raise TypeError("could not create BorescopeKinematics from a bounds dict")

    def fk(mu, sigma=None, l=None, n_arc=None):
        mu = [float(v) for v in mu]
        if abs(mu[0] - math.pi) < 1e-4:                # the model needs theta != pi (rho = sigma / (pi - theta)):
            mu[0] = math.pi + 1e-4                     # 0.0001 rad of bend = 0.003 mm over the neck, i.e. straight
        b = dict(template)
        for k, v in zip(MODEL_KEYS, mu):              # a constant profile: the first sample is exactly mu.
            b["initial_" + k] = float(v)               # (final differs by 1e-9 because the model divides by
            b["final_" + k] = float(v) + 1e-9          #  final - initial somewhere)
        kin = make(b)
        g = lambda name: np.asarray(getattr(kin, name), float)[0]
        start, ne, cam = g("neck_translation_position_meters"), g("neck_position_meters"), g("camera_position_meters")
        T = cam - ne
        T = T / (np.linalg.norm(T) or 1.0)
        return dict(start=start, arc=g("probe_sector_points_meters"), neck_end=ne, camera=cam, tangent=T,
                    up=np.array([0.0, 0.0, 1.0]))
    return fk


def check_model_fk(mod, bounds, kin):
    """Validation of model_fk: the model's profile starts at its 'initial_' values and ends at its 'final_' values,
    so model_fk(those mu) must give its first and last samples. Prints the differences in mm (~0 = right)."""
    fk = model_fk(mod, bounds)
    for idx, which in ((0, "initial"), (-1, "final")):
        mu = [bounds[which + "_" + k] for k in MODEL_KEYS]
        f = fk(mu)
        e = [np.linalg.norm(f[a] - np.asarray(getattr(kin, b), float)[idx]) * 1000 for a, b in (
            ("start", "neck_translation_position_meters"), ("neck_end", "neck_position_meters"),
            ("camera", "camera_position_meters"))]
        print(f"[check] {which:7s} mu: neck start {e[0]:.4f} mm | neck end {e[1]:.4f} mm | camera {e[2]:.4f} mm")
    print("[check] ~0 = model_fk computes positions exactly like the kinematic model")
