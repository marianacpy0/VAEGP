SCRIPT_DIR = r"C:\path\to\borescope_inspection"     # folder with borescope_config.py + borescope_setup.py
MODEL_PY = r"C:\path\to\borescope_inspection\spatial_borescope_model.py"   # <- your model file
VIEW_FROM_TIP = True            # viewport looks through the tip camera (switch back in the camera menu)
CASING   = "/root/stator_wports"   # the casing the port goes through (used to find its inner wall)
PORT_DEPTH_MM = None            # model origin along the port, from the cutter centre (+ = into the engine).
                                # None = automatic: the INNER wall of the casing, where the probe comes out
PROFILE  = "inspection"         # any profile in resolve_motion_profile
GRAVITY  = False

CABLE_DIAMETER_MM = 6.1
NECK_LENGTH_MM    = 50.0        # sigma
CAMERA_LENGTH_MM  = 20.0        # l
NECK_SEGMENTS     = 12
TUBE_LENGTH_MM    = 300.0       # cable behind the neck at lambda = 0 (it is pushed through the port)
TUBE_LINK_MM      = 20.0        # fewer links = faster (tube is straight without gravity)
MASS_PER_M_G      = 50.0        # cable mass per metre (only matters with gravity / dynamics)
EI_OVER_W_M3      = 4.4687e-3   # bench-validated stiffness / weight per metre
HOLD_S            = 1.6         # 0-1.05 s: joint-direction self-check, then settle at the first pose
PHYSICS_HZ        = 120

ROOT = "/PortProbe"


# =============================================================================
# MODEL -> TARGETS
# =============================================================================
def load_model():
    spec = importlib.util.spec_from_file_location("spatial_borescope_model", MODEL_PY)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    if hasattr(mod, "motion_profile"):
        mod.motion_profile = PROFILE
    # the model script starts its own viewer animation when loaded: switch it off (it writes the stage every frame)
    if hasattr(mod, "stop_animation"):
        mod.stop_animation = True
    for name in dir(mod):
        if "sub" in name.lower() and not name.startswith("__") and not callable(getattr(mod, name)):
            setattr(mod, name, None)
    bounds = mod.resolve_motion_profile(PROFILE)
    for make in (lambda: mod.BorescopeKinematics(bounds), lambda: mod.BorescopeKinematics(**bounds),
                 lambda: mod.BorescopeKinematics(PROFILE)):
        try:
            return mod, bounds, make()
        except TypeError:
            pass
    raise TypeError("Could not create BorescopeKinematics: change the 3 calls in load_model().")


def unit(v):
    n = np.linalg.norm(v)
    return v / n if n > 1e-12 else v


def Rx(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[1, 0, 0], [0, c, -s], [0, s, c]])


def Ry(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, 0, s], [0, 1, 0], [-s, 0, c]])


def Rz(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, -s, 0], [s, c, 0], [0, 0, 1]])


def resample(P, n):
    s = np.r_[0.0, np.cumsum(np.linalg.norm(np.diff(P, axis=0), axis=1))]
    u = np.linspace(0.0, s[-1], n + 1)
    return np.stack([np.interp(u, s, P[:, k]) for k in range(3)], 1)


def tilt_angles(d, F):
    """X-then-Z revolute angles that turn frame F so its +Y axis points along d. Returns (a, b, new F)."""
    t = F.T @ d
    b = -math.asin(float(np.clip(t[0], -1, 1)))
    a = math.atan2(t[2], t[1])
    return a, b, F @ Rx(a) @ Rz(b)


def joint_targets(arc, start, neck_end, cam, roll):
    """Pivot angles at the port, push length, and the neck joint angles that put every neck link along the
    model's arc and the head on the model's camera. Solved link by link in the actual parent frame."""
    A = np.asarray(arc, float)
    T0 = unit(-3 * A[0] + 4 * A[1] - A[2])            # neck start tangent
    u = unit(start) if np.linalg.norm(start) > 2e-3 else T0   # tube direction: port -> neck start
    pa, pb, F = tilt_angles(u, np.eye(3))
    lam = float(np.dot(start, u))
    F = F @ Ry(roll)
    pts = resample(A, NECK_SEGMENTS)
    dirs = [unit(b - a) for a, b in zip(pts[:-1], pts[1:])] + [unit(cam - neck_end)]
    neck = []
    for d in dirs:
        a, b, F = tilt_angles(d, F)
        neck.append((a, b))
    kink = math.degrees(math.acos(float(np.clip(np.dot(u, T0), -1, 1))))
    off = float(np.linalg.norm(np.cross(start, u)))
    return (pa, pb), lam, neck, kink, off


def model_targets(bounds, kin):
    t = np.asarray(kin.simulation_time_seconds, float)
    start = np.asarray(kin.neck_translation_position_meters, float)
    arcs = np.asarray(kin.probe_sector_points_meters, float)
    necks = np.asarray(kin.neck_position_meters, float)
    cams = np.asarray(kin.camera_position_meters, float)
    # roll follows the same time law as the insertion (recovered from the insertion length)
    lam_n = np.linalg.norm(start, axis=1)
    l0, l1 = bounds["initial_y_translation_meters"], bounds["final_y_translation_meters"]
    s = np.clip((lam_n - l0) / (l1 - l0), 0, 1) if abs(l1 - l0) > 1e-12 else np.zeros_like(lam_n)
    r0, r1 = bounds["initial_roll_angle_rad"], bounds["final_roll_angle_rad"]
    roll = r0 + (r1 - r0) * s
    R = [joint_targets(arcs[i], start[i], necks[i], cams[i], roll[i]) for i in range(len(t))]
    return dict(t=t, roll=roll, pivot=np.array([r[0] for r in R]), lam=np.array([r[1] for r in R]),
                neck=np.array([r[2] for r in R]), kink=np.array([r[3] for r in R]),
                off=np.array([r[4] for r in R]), necks=necks, cams=cams)


# =============================================================================
# BUILD (all lengths in metres; stage assumed in metres)
# =============================================================================
def body(stage, path, end_y, length, radius, mass, color=None, geom="capsule"):
    """Rigid link whose ORIGIN is its far end (so its position = the point we measure)."""
    x = UsdGeom.Xform.Define(stage, path)
    x.AddTranslateOp().Set(Gf.Vec3d(0.0, end_y, 0.0))
    p = x.GetPrim()
    UsdPhysics.RigidBodyAPI.Apply(p)
    m = UsdPhysics.MassAPI.Apply(p)
    m.CreateMassAttr(mass)
    m.CreateCenterOfMassAttr(Gf.Vec3f(0.0, -length / 2, 0.0))
    ia = mass * (3 * radius ** 2 + length ** 2) / 12.0
    m.CreateDiagonalInertiaAttr(Gf.Vec3f(max(ia, 1e-10), max(mass * radius ** 2 / 2.0, 1e-10), max(ia, 1e-10)))
    rb = PhysxSchema.PhysxRigidBodyAPI.Apply(p)
    rb.CreateDisableGravityAttr(not GRAVITY)
    rb.CreateLinearDampingAttr(0.5)
    rb.CreateAngularDampingAttr(0.5)
    if color is not None and length > 0:
        g = (UsdGeom.Capsule if geom == "capsule" else UsdGeom.Cylinder).Define(stage, path + "/geom")
        g.CreateAxisAttr(UsdGeom.Tokens.y)
        g.CreateRadiusAttr(radius)
        g.CreateHeightAttr(length)                  # capsules overlap a little -> smooth cable
        g.CreateDisplayColorAttr([Gf.Vec3f(*color)])
        g.AddTranslateOp().Set(Gf.Vec3d(0.0, -length / 2, 0.0))
    return p


def joint(stage, path, kind, b0, b1, pos0, pos1, axis=None, drive=None):
    J = {"fixed": UsdPhysics.FixedJoint, "prismatic": UsdPhysics.PrismaticJoint,
         "revolute": UsdPhysics.RevoluteJoint}[kind].Define(stage, path)
    if b0 is not None:
        J.CreateBody0Rel().SetTargets([b0.GetPath()])
    J.CreateBody1Rel().SetTargets([b1.GetPath()])
    J.CreateLocalPos0Attr(Gf.Vec3f(*pos0))
    J.CreateLocalPos1Attr(Gf.Vec3f(*pos1))
    J.CreateLocalRot0Attr(Gf.Quatf(1.0))
    J.CreateLocalRot1Attr(Gf.Quatf(1.0))
    if axis:
        J.CreateAxisAttr(axis)
    if drive:
        name, k, c, target = drive
        d = UsdPhysics.DriveAPI.Apply(J.GetPrim(), name)
        d.CreateTypeAttr("force")
        d.CreateStiffnessAttr(k)
        d.CreateDampingAttr(c)
        return d.CreateTargetPositionAttr(target)
    return None


def junction(stage, path, parent, child, child_len, spacer_y, k_deg, c_deg, a0=0.0, b0=0.0):
    """Two revolute joints (X then Z) through a tiny spacer body = a bending joint with 2 axes."""
    sp = body(stage, path + "_spacer", spacer_y, 0.0, 1e-3, 1e-4)
    ax = joint(stage, path + "_x", "revolute", parent, sp, (0, 0, 0), (0, 0, 0), "X", ("angular", k_deg, c_deg, a0))
    az = joint(stage, path + "_z", "revolute", sp, child, (0, 0, 0), (0, -child_len, 0), "Z", ("angular", k_deg, c_deg, b0))
    return ax, az


def build(stage, first, port):
    if stage.GetPrimAtPath(ROOT):
        stage.RemovePrim(ROOT)
    O, Rm = port
    rx = UsdGeom.Xform.Define(stage, ROOT)                   # the model frame, sitting on the port
    rx.AddTransformOp().Set(Gf.Matrix4d(*Rm[0], 0, *Rm[1], 0, *Rm[2], 0, *O, 1))
    root = rx.GetPrim()
    UsdPhysics.ArticulationRootAPI.Apply(root)
    art = PhysxSchema.PhysxArticulationAPI.Apply(root)
    art.CreateEnabledSelfCollisionsAttr(False)
    art.CreateSolverPositionIterationCountAttr(16)
    art.CreateSolverVelocityIterationCountAttr(4)

    if not any(p.IsA(UsdPhysics.Scene) for p in stage.Traverse()):
        sc = UsdPhysics.Scene.Define(stage, "/World/physicsScene")
        sc.CreateGravityDirectionAttr(Gf.Vec3f(0, 0, -1))
        sc.CreateGravityMagnitudeAttr(9.81)
    for p in stage.Traverse():
        if p.IsA(UsdPhysics.Scene):
            PhysxSchema.PhysxSceneAPI.Apply(p).CreateTimeStepsPerSecondAttr(PHYSICS_HZ)

    r = CABLE_DIAMETER_MM / 2000.0
    w = MASS_PER_M_G / 1000.0
    Lt, nt = TUBE_LINK_MM / 1000.0, int(round(TUBE_LENGTH_MM / TUBE_LINK_MM))
    Ln, L_head = NECK_LENGTH_MM / 1000.0 / NECK_SEGMENTS, CAMERA_LENGTH_MM / 1000.0
    tail = -nt * Lt
    deg = math.pi / 180.0
    k_tube = EI_OVER_W_M3 * w * 9.81 / Lt * deg            # passive bending spring  [N m / deg]
    c_tube = k_tube * 0.004
    k_neck, c_neck = 2.0 * deg, 0.02 * deg                 # stiff position drives on the neck
    k_push, c_push = 4000.0, 40.0
    k_rot, c_rot = 2.0 * deg, 0.02 * deg

    base = body(stage, ROOT + "/PortBase", 0.0, 0.0, r, 0.01)
    joint(stage, ROOT + "/J_world", "fixed", None, base, tuple(O), (0, 0, 0))   # world side = the port
    q = Gf.Matrix4d(*Rm[0], 0, *Rm[1], 0, *Rm[2], 0, 0, 0, 0, 1).ExtractRotation().GetQuat()
    UsdPhysics.FixedJoint.Get(stage, ROOT + "/J_world").CreateLocalRot0Attr().Set(Gf.Quatf(q))
    pivot = body(stage, ROOT + "/Pivot", 0.0, 0.0, r, 0.005)
    pa, pb = first["pivot"]
    piv = junction(stage, ROOT + "/J_pivot", base, pivot, 0.0, 0.0, k_neck * 20, c_neck * 20,
                   math.degrees(pa), math.degrees(pb))
    car = body(stage, ROOT + "/Carriage", tail, 0.0, r, 0.005)
    push = joint(stage, ROOT + "/J_push", "prismatic", pivot, car, (0, tail, 0), (0, 0, 0), "Y",
                 ("linear", k_push, c_push, float(first["lam"])))
    J = stage.GetPrimAtPath(ROOT + "/J_push")
    UsdPhysics.PrismaticJoint(J).CreateLowerLimitAttr(-0.05)
    UsdPhysics.PrismaticJoint(J).CreateUpperLimitAttr(1.0)

    tubes = [body(stage, f"{ROOT}/Tube_{i:02d}", tail + (i + 1) * Lt, Lt, r, w * Lt, (0.12, 0.12, 0.12))
             for i in range(nt)]
    rot = joint(stage, ROOT + "/J_rotate", "revolute", car, tubes[0], (0, 0, 0), (0, -Lt, 0), "Y",
                ("angular", k_rot, c_rot, math.degrees(first["roll"])))
    for i in range(nt - 1):
        junction(stage, f"{ROOT}/J_tube_{i:02d}", tubes[i], tubes[i + 1], Lt, tail + (i + 1) * Lt, k_tube, c_tube)

    necks = [body(stage, f"{ROOT}/Neck_{j:02d}", (j + 1) * Ln, Ln, r, w * Ln, (0.45, 0.45, 0.48))
             for j in range(NECK_SEGMENTS)]
    head = body(stage, ROOT + "/Head", NECK_LENGTH_MM / 1000.0 + L_head, L_head, r, 0.002, (0.75, 0.75, 0.78),
                geom="cylinder")
    links = [tubes[-1]] + necks + [head]
    neck_attrs = []
    for j in range(NECK_SEGMENTS + 1):
        a, b = first["neck"][j]
        child_len = Ln if j < NECK_SEGMENTS else L_head
        neck_attrs.append(junction(stage, f"{ROOT}/J_neck_{j:02d}", links[j], links[j + 1], child_len, j * Ln,
                                   k_neck, c_neck, math.degrees(a), math.degrees(b)))

    cam_path = ROOT + "/Head/TipCamera"
    cam = UsdGeom.Camera.Define(stage, cam_path)     # looks down -Z: turn it to look along +Y (probe axis)
    cam.AddTranslateOp().Set(Gf.Vec3d(0.0, 0.0002, 0.0))   # 0.2 mm ahead of the head's end face
    cam.AddRotateXOp().Set(90.0)
    W, H = C.CAM_RES                                 # calibrated camera, same as borescope_setup
    cam.CreateHorizontalApertureAttr(20.955)
    cam.CreateVerticalApertureAttr(20.955 * H / W)
    cam.CreateFocalLengthAttr(C.FX * 20.955 / W)
    cam.CreateClippingRangeAttr(Gf.Vec2f(0.0005, 3.0))
    UsdGeom.Imageable(cam).MakeInvisible()          # hides the big camera icon; you can still look through it
    print(f"[probe] camera: {S.apply_distortion(stage, cam_path)}")
    led = UsdLux.DiskLight.Define(stage, cam_path + "/LED")
    led.CreateRadiusAttr(0.0015)
    led.CreateIntensityAttr(C.LED_INTENSITY)
    led.CreateExposureAttr(C.LED_EXPOSURE)
    led.CreateNormalizeAttr(True)
    led.CreateEnableColorTemperatureAttr(True)
    led.CreateColorTemperatureAttr(6500.0)
    sh = UsdLux.ShapingAPI.Apply(led.GetPrim())
    sh.CreateShapingConeAngleAttr(C.LED_CONE_DEG)
    sh.CreateShapingConeSoftnessAttr(0.3)
    led.AddTranslateOp().Set(Gf.Vec3d(0, 0, 0.0001))           # 0.1 mm behind the lens, still outside the head
    glow = UsdGeom.Cylinder.Define(stage, cam_path + "/LEDGlow")   # small lit disc so you can see the LED
    glow.CreateAxisAttr(UsdGeom.Tokens.z)
    glow.CreateRadiusAttr(CABLE_DIAMETER_MM / 2000.0 * 0.6)
    glow.CreateHeightAttr(0.0001)
    glow.AddTranslateOp().Set(Gf.Vec3d(0, 0, 0.00015))
    mat = UsdShade.Material.Define(stage, cam_path + "/LEDGlowMat")
    shd = UsdShade.Shader.Define(stage, cam_path + "/LEDGlowMat/Shader")
    shd.CreateIdAttr("UsdPreviewSurface")
    shd.CreateInput("diffuseColor", Sdf.ValueTypeNames.Color3f).Set(Gf.Vec3f(1.0, 1.0, 0.95))
    shd.CreateInput("emissiveColor", Sdf.ValueTypeNames.Color3f).Set(Gf.Vec3f(1.0, 1.0, 0.9))
    mat.CreateSurfaceOutput().ConnectToSource(shd.ConnectableAPI(), "surface")
    UsdShade.MaterialBindingAPI.Apply(glow.GetPrim()).Bind(mat)
    carb.settings.get_settings().set("/rtx/post/histogram/enabled", True)   # auto exposure
    collar = UsdGeom.Cylinder.Define(stage, ROOT + "/PortCollar")        # visual only
    collar.CreateAxisAttr(UsdGeom.Tokens.y)
    collar.CreateRadiusAttr(r * 1.8)
    collar.CreateHeightAttr(0.01)
    collar.CreateDisplayColorAttr([Gf.Vec3f(1.0, 0.2, 0.2)])
    collar.CreateDisplayOpacityAttr([0.5])
    return push, rot, neck_attrs, piv


def curve(stage, path, P, color):
    c = UsdGeom.BasisCurves.Define(stage, path)
    c.CreateTypeAttr(UsdGeom.Tokens.linear)
    c.CreateCurveVertexCountsAttr(Vt.IntArray([len(P)]))
    c.CreatePointsAttr(Vt.Vec3fArray.FromNumpy(np.asarray(P, np.float32)))
    c.CreateWidthsAttr(Vt.FloatArray([0.0015]))
    c.SetWidthsInterpolation(UsdGeom.Tokens.constant)
    c.CreateDisplayColorAttr([Gf.Vec3f(*color)])


def port_depth(stage, rig):
    """Where the probe comes out of the casing: the inner wall around the hole, measured along the port
    axis from the cutter centre. Uses the casing vertices that sit on the rim of the hole."""
    cut = S.mesh_data(rig.port, rig.mpu) - rig.O
    rc = float(np.median(np.linalg.norm(cut - np.outer(cut @ rig.Y, rig.Y), axis=1)))     # hole radius
    P = S.mesh_data(stage.GetPrimAtPath(CASING), rig.mpu) if stage.GetPrimAtPath(CASING) else None
    if P is None:
        print(f"[probe] {CASING} not found: model origin left at the cutter centre (set PORT_DEPTH_MM)")
        return 0.0
    d = P - rig.O
    t = d @ rig.Y
    r = np.linalg.norm(d - np.outer(t, rig.Y), axis=1)
    ts = np.sort(t[(r > 0.85 * rc) & (r < 1.3 * rc) & (np.abs(t) < rig.port_len / 2)])
    if len(ts) == 0:
        print("[probe] no casing found around the hole: origin left at the cutter centre (set PORT_DEPTH_MM)")
        return 0.0
    cuts = np.where(np.diff(ts) > 0.002)[0]                      # rings of rim vertices along the axis
    rings = np.split(ts, cuts + 1)
    walls = [(float(g[0]), float(g[-1])) for g in rings]
    t_in = walls[1][1] if len(walls) > 1 else walls[0][1]          # outer surface ring, then inner surface ring
    print(f"[probe] port hole radius {rc * 1000:.1f} mm | casing rims at "
          f"{', '.join(f'{a * 1000:.0f}' for a, _ in walls[:4])} mm from the cutter centre | "
          f"model origin on the inner wall: {t_in * 1000:.1f} mm  (override with PORT_DEPTH_MM)")
    return t_in


# =============================================================================
# RUN
# =============================================================================
def main():
    global C, S
    if SCRIPT_DIR not in sys.path:
        sys.path.insert(0, SCRIPT_DIR)
    for m in ("borescope_config", "borescope_setup"):
        importlib.reload(sys.modules[m]) if m in sys.modules else importlib.import_module(m)
    C, S = sys.modules["borescope_config"], sys.modules["borescope_setup"]
    old = getattr(builtins, "_jointed_probe_sub", None)
    if old is not None:
        builtins._jointed_probe_sub = None                 # dropping the subscription stops the old run
    tl = omni.timeline.get_timeline_interface()
    tl.stop()

    mod, bounds, kin = load_model()
    M = model_targets(bounds, kin)
    for name, ours in (("fixed_curvature_length_meters", NECK_LENGTH_MM), ("camera_distance_meters", CAMERA_LENGTH_MM)):
        v = getattr(mod, name, None)
        if v is not None and abs(v * 1000 - ours) > 1e-6:
            print(f"[probe] WARNING: model {name} = {v * 1000:.2f} mm, probe uses {ours:.2f} mm")

    stage = omni.usd.get_context().get_stage()
    if abs((UsdGeom.GetStageMetersPerUnit(stage) or 1.0) - 1.0) > 1e-9:
        print("[probe] WARNING: stage is not in metres; positions will be off")
    if not stage.GetPrimAtPath(C.PORT):
        print(f"[probe] ERROR: no {C.PORT} in the stage: open the engine first")
        return
    rig = S.Rig()                                    # port fit: origin, +Y into the engine, +Z up
    depth = port_depth(stage, rig) if PORT_DEPTH_MM is None else PORT_DEPTH_MM / 1000.0
    O, Rm = rig.O + depth * rig.Y, np.stack([rig.X, rig.Y, rig.Z])   # rows = model x, y, z in world
    UsdGeom.Imageable(rig.port).MakeInvisible()      # the cutter sits in the hole
    if stage.GetPrimAtPath("/Borescope"):
        stage.RemovePrim("/Borescope")               # the static probe from main.py, if it is there
    to_world = lambda P: O + np.asarray(P, float) @ Rm
    print(f"[probe] port {C.PORT}: origin {np.round(O, 4).tolist()} | into the engine {np.round(rig.Y, 3).tolist()}")
    first = dict(lam=M["lam"][0], roll=M["roll"][0], neck=M["neck"][0], pivot=M["pivot"][0])
    push, rot, neck_attrs, piv_attrs = build(stage, first, (O, Rm))

    t, T = M["t"], M["t"][-1]
    N1 = NECK_SEGMENTS + 1
    nt = int(round(TUBE_LENGTH_MM / TUBE_LINK_MM))
    LINKS = dict(tail=f"Tube_{nt - 1:02d}", n0="Neck_00", nl=f"Neck_{NECK_SEGMENTS - 1:02d}", head="Head")
    # joint-direction self-check (PhysX decides which way a positive joint angle turns; we measure it)
    CAL = (("x", 0.0, 0.35), ("z", 0.35, 0.70), ("rot", 0.70, 1.05))
    rec = dict(k=0, neck=[], cam=[], done=False, backend=None, fails=0,
               sign=dict(x=1.0, z=1.0, rot=1.0), cal_done=set())
    physx = omni.physx.get_physx_interface()

    def model_at(tau):
        f = lambda arr: float(np.interp(tau, t, arr))
        return (f(M["lam"]), f(M["roll"]), (f(M["pivot"][:, 0]), f(M["pivot"][:, 1])),
                np.array([[f(M["neck"][:, j, c]) for c in (0, 1)] for j in range(N1)]))

    # ---------- backend 1: PhysX tensor API (fast) ----------
    def connect_tensors():
        import omni.physics.tensors as tensors
        try:
            sim = tensors.create_simulation_view("numpy", stage_id=omni.usd.get_context().get_stage_id())
        except TypeError:
            sim = tensors.create_simulation_view("numpy")
        sim.set_subspace_roots("/")
        art = sim.create_articulation_view(ROOT)
        mt = art.shared_metatype
        dof = {n: i for i, n in enumerate(mt.dof_names)}
        link = {n: i for i, n in enumerate(mt.link_names)}
        need = ["J_push", "J_rotate", "J_pivot_x", "J_pivot_z"] + [f"J_neck_{j:02d}_{c}" for j in range(N1) for c in "xz"]
        miss = [n for n in need if n not in dof] + [n for n in LINKS.values() if n not in link]
        if miss:
            raise RuntimeError(f"names not found {miss[:3]}; dofs {list(dof)[:4]}..., links {list(link)[:4]}...")
        base = art.get_dof_position_targets().copy()
        ix = dict(push=dof["J_push"], rot=dof["J_rotate"], px=dof["J_pivot_x"], pz=dof["J_pivot_z"],
                  nx=[dof[f"J_neck_{j:02d}_x"] for j in range(N1)], nz=[dof[f"J_neck_{j:02d}_z"] for j in range(N1)])
        li = {k: link[v] for k, v in LINKS.items()}

        def send(lam, roll, pv, ab):
            sg = rec["sign"]
            tg = base.copy()
            tg[0, ix["push"]] = lam
            tg[0, ix["rot"]] = sg["rot"] * roll
            tg[0, ix["px"]], tg[0, ix["pz"]] = sg["x"] * pv[0], sg["z"] * pv[1]
            tg[0, ix["nx"]] = sg["x"] * ab[:, 0]
            tg[0, ix["nz"]] = sg["z"] * ab[:, 1]
            art.set_dof_position_targets(tg.astype(np.float32), np.array([0], dtype=np.int32))

        def where():
            P = np.asarray(art.get_link_transforms())[0, :, :3]
            return {k: P[i].copy() for k, i in li.items()}
        return dict(name="PhysX tensors", send=send, where=where, keep=sim)

    # ---------- backend 2: USD drive targets (works everywhere) ----------
    def connect_usd():
        deg = math.degrees

        def send(lam, roll, pv, ab):
            sg = rec["sign"]
            with Sdf.ChangeBlock():
                push.Set(float(lam))
                rot.Set(deg(sg["rot"] * roll))
                piv_attrs[0].Set(deg(sg["x"] * pv[0]))
                piv_attrs[1].Set(deg(sg["z"] * pv[1]))
                for j, (ax, az) in enumerate(neck_attrs):
                    ax.Set(deg(sg["x"] * ab[j, 0]))
                    az.Set(deg(sg["z"] * ab[j, 1]))

        def where():
            out = {}
            for k, v in LINKS.items():
                q = physx.get_rigidbody_transformation(f"{ROOT}/{v}")["position"]
                out[k] = np.array([q[0], q[1], q[2]], float)
            return out
        return dict(name="USD drive targets", send=send, where=where)

    def report():
        en = np.linalg.norm(np.array(rec["neck"]) - to_world(M["necks"]), axis=1) * 1000
        ec = np.linalg.norm(np.array(rec["cam"]) - to_world(M["cams"]), axis=1) * 1000
        print("\n================ JOINTED PROBE vs MODEL ================")
        print(f"profile '{PROFILE}', {len(t)} steps, gravity {'ON' if GRAVITY else 'OFF'}, via {rec['backend']['name']}")
        print(f"neck end : max {en.max():.3f} mm   rms {np.sqrt(np.mean(en ** 2)):.3f} mm   final {en[-1]:.3f} mm")
        print(f"camera   : max {ec.max():.3f} mm   rms {np.sqrt(np.mean(ec ** 2)):.3f} mm   final {ec[-1]:.3f} mm")
        print("=========================================================")

    def on_update(_):
        try:
            if not tl.is_playing():                  # stopped / paused: never touch the physics
                if rec["backend"] is not None and tl.get_current_time() <= 1e-6:
                    rec.update(k=0, neck=[], cam=[], done=False, backend=None, fails=0, cal_done=set())
                return
            if rec["backend"] is None:
                try:
                    rec["backend"] = connect_tensors()
                except Exception as e:
                    rec["fails"] += 1
                    if rec["fails"] < 10:
                        return                       # physics may need a few frames to start
                    print(f"[probe] tensor API not available ({e}); using USD drive targets")
                    rec["backend"] = connect_usd()
                print(f"[probe] driving the joints via {rec['backend']['name']}")
            B = rec["backend"]
            now = tl.get_current_time()
            lam0, roll0, pv0, ab0 = model_at(0.0)
            # ---- self-check: bend one joint at a time (pivot straight) and see where the first neck link goes
            for name, a, b in CAL:
                if a <= now < b:
                    ab = np.zeros((N1, 2))
                    ab[0] = (0.3, 0.0) if name in ("x", "rot") else (0.0, 0.3)
                    B["send"](lam0, 0.4 if name == "rot" else 0.0, (0.0, 0.0), ab)
                    return
                if now >= b and name not in rec["cal_done"]:
                    P = B["where"]()
                    d = Rm @ (P["n0"] - P["tail"])          # in the port (model) frame
                    sg = rec["sign"]
                    if name == "x":
                        sg["x"] = 1.0 if d[2] > 0 else -1.0          # +X bend must lift the link toward +Z
                    elif name == "z":
                        sg["z"] = 1.0 if d[0] < 0 else -1.0          # +Z bend must swing it toward -X
                    else:
                        sg["rot"] = 1.0 if d[0] > 0 else -1.0        # +roll must turn the +Z bend toward +X
                        print(f"[probe] joint directions measured: X {sg['x']:+.0f}, Z {sg['z']:+.0f}, "
                              f"roll {sg['rot']:+.0f}")
                    rec["cal_done"].add(name)
            # ---- the model profile
            tau = min(max(now - HOLD_S, 0.0), T)
            B["send"](*model_at(tau))
            if now >= HOLD_S:
                P = None
                while rec["k"] < len(t) and tau >= t[rec["k"]] - 1e-9:
                    P = B["where"]() if P is None else P
                    rec["neck"].append(P["nl"])
                    rec["cam"].append(P["head"])
                    rec["k"] += 1
                if rec["k"] == len(t) and not rec["done"]:
                    rec["done"] = True
                    report()
        except Exception as e:                       # never let the callback take Isaac down
            print(f"[probe] update skipped: {e}")

    builtins._jointed_probe_sub = omni.kit.app.get_app().get_update_event_stream().create_subscription_to_pop(
        on_update, name="jointed_probe")
    tl.set_start_time(0.0)
    tl.set_end_time(HOLD_S + T + 5.0)
    tl.set_looping(False)
    tl.set_current_time(0.0)

    print("\n================ JOINTED PROBE ================")
    print(f"profile '{PROFILE}': {len(t)} steps, {T:.2f} s (starts after {HOLD_S:.1f} s self-check + hold)")
    print(f"push {M['lam'][0] * 1000:.1f} -> {M['lam'][-1] * 1000:.1f} mm, "
          f"pivot at the port up to {np.degrees(np.abs(M['pivot'])).max():.1f} deg, "
          f"roll {math.degrees(M['roll'][0]):.1f} -> {math.degrees(M['roll'][-1]):.1f} deg")
    print(f"model check: neck start off the pivoted tube line max {M['off'].max() * 1000:.3f} mm, "
          f"kink tube -> neck max {M['kink'].max():.2f} deg  (both should be ~0)")
    if VIEW_FROM_TIP:
        try:
            from omni.kit.viewport.utility import get_active_viewport
            get_active_viewport().camera_path = ROOT + "/Head/TipCamera"
        except Exception as e:
            print(f"[probe] pick the camera by hand (Camera menu > PortProbe > TipCamera): {e}")
    tl.play()


main()








"""
port_probe.py  -  Isaac Sim 6, run from Window > Script Editor.

The jointed borescope (PhysX articulation) driven by YOUR kinematic model (spatial_borescope_model.py),
placed IN THE ENGINE at the inspection port, with the calibrated tip camera + LED.
Same probe as model_driven_probe.py: the model's frame (origin at the port, +Y into the engine, +Z up)
is simply put on the port. Open the engine first (engine_textured.usd), then run this.

    world --fixed--> PortBase --2-axis PIVOT at the port (probe tilt)--> Pivot --prismatic (PUSH, lambda)-->
    Carriage --revolute (ROLL about the probe axis)--> Tube_00
    Tube_00 ... Tube_N   capsule links, 2 revolute joints (X, Z) per junction with a bending spring (passive cable)
    Neck_00 ... Neck_11  capsule links, 2 revolute joints (X, Z) per junction with position drives (the bending neck)
    Head                 rigid camera head (20 mm) + tip camera

The cable is pushed through the port: the part behind the port slides in, it is not teleported.
Every physics step the model gives the targets: push (lambda), axial rotation, and the neck joint angles that put
each neck link along the model's neck arc. PhysX moves the joints; the script reads where the neck end and the
camera really are and compares them with the model (printed at the end).

Gravity: GRAVITY = False (pure kinematics test). True = the tube sags with the bench-calibrated stiffness.
"""

import builtins
import importlib.util
import math
import numpy as np
import omni.kit.app
import omni.physx
import omni.timeline
import omni.usd
from pxr import Gf, PhysxSchema, Sdf, UsdGeom, UsdLux, UsdPhysics, Vt
import sys
import importlib
import carb
C = S = None                    # borescope_config / borescope_setup, loaded in main() from SCRIPT_DIR

# =============================================================================
# SETTINGS
# =============================================================================
SCRIPT_DIR = r"C:\path\to\borescope_inspection"     # folder with borescope_config.py + borescope_setup.py
MODEL_PY = r"C:\path\to\borescope_inspection\spatial_borescope_model.py"   # <- your model file
VIEW_FROM_TIP = True            # viewport looks through the tip camera (switch back in the camera menu)
PROFILE  = "inspection"         # any profile in resolve_motion_profile
GRAVITY  = False

CABLE_DIAMETER_MM = 6.1
NECK_LENGTH_MM    = 50.0        # sigma
CAMERA_LENGTH_MM  = 20.0        # l
NECK_SEGMENTS     = 12
TUBE_LENGTH_MM    = 300.0       # cable behind the neck at lambda = 0 (it is pushed through the port)
TUBE_LINK_MM      = 20.0        # fewer links = faster (tube is straight without gravity)
MASS_PER_M_G      = 50.0        # cable mass per metre (only matters with gravity / dynamics)
EI_OVER_W_M3      = 4.4687e-3   # bench-validated stiffness / weight per metre
HOLD_S            = 1.6         # 0-1.05 s: joint-direction self-check, then settle at the first pose
PHYSICS_HZ        = 120

ROOT = "/PortProbe"


# =============================================================================
# MODEL -> TARGETS
# =============================================================================
def load_model():
    spec = importlib.util.spec_from_file_location("spatial_borescope_model", MODEL_PY)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    if hasattr(mod, "motion_profile"):
        mod.motion_profile = PROFILE
    # the model script starts its own viewer animation when loaded: switch it off (it writes the stage every frame)
    if hasattr(mod, "stop_animation"):
        mod.stop_animation = True
    for name in dir(mod):
        if "sub" in name.lower() and not name.startswith("__") and not callable(getattr(mod, name)):
            setattr(mod, name, None)
    bounds = mod.resolve_motion_profile(PROFILE)
    for make in (lambda: mod.BorescopeKinematics(bounds), lambda: mod.BorescopeKinematics(**bounds),
                 lambda: mod.BorescopeKinematics(PROFILE)):
        try:
            return mod, bounds, make()
        except TypeError:
            pass
    raise TypeError("Could not create BorescopeKinematics: change the 3 calls in load_model().")


def unit(v):
    n = np.linalg.norm(v)
    return v / n if n > 1e-12 else v


def Rx(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[1, 0, 0], [0, c, -s], [0, s, c]])


def Ry(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, 0, s], [0, 1, 0], [-s, 0, c]])


def Rz(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, -s, 0], [s, c, 0], [0, 0, 1]])


def resample(P, n):
    s = np.r_[0.0, np.cumsum(np.linalg.norm(np.diff(P, axis=0), axis=1))]
    u = np.linspace(0.0, s[-1], n + 1)
    return np.stack([np.interp(u, s, P[:, k]) for k in range(3)], 1)


def tilt_angles(d, F):
    """X-then-Z revolute angles that turn frame F so its +Y axis points along d. Returns (a, b, new F)."""
    t = F.T @ d
    b = -math.asin(float(np.clip(t[0], -1, 1)))
    a = math.atan2(t[2], t[1])
    return a, b, F @ Rx(a) @ Rz(b)


def joint_targets(arc, start, neck_end, cam, roll):
    """Pivot angles at the port, push length, and the neck joint angles that put every neck link along the
    model's arc and the head on the model's camera. Solved link by link in the actual parent frame."""
    A = np.asarray(arc, float)
    T0 = unit(-3 * A[0] + 4 * A[1] - A[2])            # neck start tangent
    u = unit(start) if np.linalg.norm(start) > 2e-3 else T0   # tube direction: port -> neck start
    pa, pb, F = tilt_angles(u, np.eye(3))
    lam = float(np.dot(start, u))
    F = F @ Ry(roll)
    pts = resample(A, NECK_SEGMENTS)
    dirs = [unit(b - a) for a, b in zip(pts[:-1], pts[1:])] + [unit(cam - neck_end)]
    neck = []
    for d in dirs:
        a, b, F = tilt_angles(d, F)
        neck.append((a, b))
    kink = math.degrees(math.acos(float(np.clip(np.dot(u, T0), -1, 1))))
    off = float(np.linalg.norm(np.cross(start, u)))
    return (pa, pb), lam, neck, kink, off


def model_targets(bounds, kin):
    t = np.asarray(kin.simulation_time_seconds, float)
    start = np.asarray(kin.neck_translation_position_meters, float)
    arcs = np.asarray(kin.probe_sector_points_meters, float)
    necks = np.asarray(kin.neck_position_meters, float)
    cams = np.asarray(kin.camera_position_meters, float)
    # roll follows the same time law as the insertion (recovered from the insertion length)
    lam_n = np.linalg.norm(start, axis=1)
    l0, l1 = bounds["initial_y_translation_meters"], bounds["final_y_translation_meters"]
    s = np.clip((lam_n - l0) / (l1 - l0), 0, 1) if abs(l1 - l0) > 1e-12 else np.zeros_like(lam_n)
    r0, r1 = bounds["initial_roll_angle_rad"], bounds["final_roll_angle_rad"]
    roll = r0 + (r1 - r0) * s
    R = [joint_targets(arcs[i], start[i], necks[i], cams[i], roll[i]) for i in range(len(t))]
    return dict(t=t, roll=roll, pivot=np.array([r[0] for r in R]), lam=np.array([r[1] for r in R]),
                neck=np.array([r[2] for r in R]), kink=np.array([r[3] for r in R]),
                off=np.array([r[4] for r in R]), necks=necks, cams=cams)


# =============================================================================
# BUILD (all lengths in metres; stage assumed in metres)
# =============================================================================
def body(stage, path, end_y, length, radius, mass, color=None, geom="capsule"):
    """Rigid link whose ORIGIN is its far end (so its position = the point we measure)."""
    x = UsdGeom.Xform.Define(stage, path)
    x.AddTranslateOp().Set(Gf.Vec3d(0.0, end_y, 0.0))
    p = x.GetPrim()
    UsdPhysics.RigidBodyAPI.Apply(p)
    m = UsdPhysics.MassAPI.Apply(p)
    m.CreateMassAttr(mass)
    m.CreateCenterOfMassAttr(Gf.Vec3f(0.0, -length / 2, 0.0))
    ia = mass * (3 * radius ** 2 + length ** 2) / 12.0
    m.CreateDiagonalInertiaAttr(Gf.Vec3f(max(ia, 1e-10), max(mass * radius ** 2 / 2.0, 1e-10), max(ia, 1e-10)))
    rb = PhysxSchema.PhysxRigidBodyAPI.Apply(p)
    rb.CreateDisableGravityAttr(not GRAVITY)
    rb.CreateLinearDampingAttr(0.5)
    rb.CreateAngularDampingAttr(0.5)
    if color is not None and length > 0:
        g = (UsdGeom.Capsule if geom == "capsule" else UsdGeom.Cylinder).Define(stage, path + "/geom")
        g.CreateAxisAttr(UsdGeom.Tokens.y)
        g.CreateRadiusAttr(radius)
        g.CreateHeightAttr(length)                  # capsules overlap a little -> smooth cable
        g.CreateDisplayColorAttr([Gf.Vec3f(*color)])
        g.AddTranslateOp().Set(Gf.Vec3d(0.0, -length / 2, 0.0))
    return p


def joint(stage, path, kind, b0, b1, pos0, pos1, axis=None, drive=None):
    J = {"fixed": UsdPhysics.FixedJoint, "prismatic": UsdPhysics.PrismaticJoint,
         "revolute": UsdPhysics.RevoluteJoint}[kind].Define(stage, path)
    if b0 is not None:
        J.CreateBody0Rel().SetTargets([b0.GetPath()])
    J.CreateBody1Rel().SetTargets([b1.GetPath()])
    J.CreateLocalPos0Attr(Gf.Vec3f(*pos0))
    J.CreateLocalPos1Attr(Gf.Vec3f(*pos1))
    J.CreateLocalRot0Attr(Gf.Quatf(1.0))
    J.CreateLocalRot1Attr(Gf.Quatf(1.0))
    if axis:
        J.CreateAxisAttr(axis)
    if drive:
        name, k, c, target = drive
        d = UsdPhysics.DriveAPI.Apply(J.GetPrim(), name)
        d.CreateTypeAttr("force")
        d.CreateStiffnessAttr(k)
        d.CreateDampingAttr(c)
        return d.CreateTargetPositionAttr(target)
    return None


def junction(stage, path, parent, child, child_len, spacer_y, k_deg, c_deg, a0=0.0, b0=0.0):
    """Two revolute joints (X then Z) through a tiny spacer body = a bending joint with 2 axes."""
    sp = body(stage, path + "_spacer", spacer_y, 0.0, 1e-3, 1e-4)
    ax = joint(stage, path + "_x", "revolute", parent, sp, (0, 0, 0), (0, 0, 0), "X", ("angular", k_deg, c_deg, a0))
    az = joint(stage, path + "_z", "revolute", sp, child, (0, 0, 0), (0, -child_len, 0), "Z", ("angular", k_deg, c_deg, b0))
    return ax, az


def build(stage, first, port):
    if stage.GetPrimAtPath(ROOT):
        stage.RemovePrim(ROOT)
    O, Rm = port
    rx = UsdGeom.Xform.Define(stage, ROOT)                   # the model frame, sitting on the port
    rx.AddTransformOp().Set(Gf.Matrix4d(*Rm[0], 0, *Rm[1], 0, *Rm[2], 0, *O, 1))
    root = rx.GetPrim()
    UsdPhysics.ArticulationRootAPI.Apply(root)
    art = PhysxSchema.PhysxArticulationAPI.Apply(root)
    art.CreateEnabledSelfCollisionsAttr(False)
    art.CreateSolverPositionIterationCountAttr(16)
    art.CreateSolverVelocityIterationCountAttr(4)

    if not any(p.IsA(UsdPhysics.Scene) for p in stage.Traverse()):
        sc = UsdPhysics.Scene.Define(stage, "/World/physicsScene")
        sc.CreateGravityDirectionAttr(Gf.Vec3f(0, 0, -1))
        sc.CreateGravityMagnitudeAttr(9.81)
    for p in stage.Traverse():
        if p.IsA(UsdPhysics.Scene):
            PhysxSchema.PhysxSceneAPI.Apply(p).CreateTimeStepsPerSecondAttr(PHYSICS_HZ)

    r = CABLE_DIAMETER_MM / 2000.0
    w = MASS_PER_M_G / 1000.0
    Lt, nt = TUBE_LINK_MM / 1000.0, int(round(TUBE_LENGTH_MM / TUBE_LINK_MM))
    Ln, L_head = NECK_LENGTH_MM / 1000.0 / NECK_SEGMENTS, CAMERA_LENGTH_MM / 1000.0
    tail = -nt * Lt
    deg = math.pi / 180.0
    k_tube = EI_OVER_W_M3 * w * 9.81 / Lt * deg            # passive bending spring  [N m / deg]
    c_tube = k_tube * 0.004
    k_neck, c_neck = 2.0 * deg, 0.02 * deg                 # stiff position drives on the neck
    k_push, c_push = 4000.0, 40.0
    k_rot, c_rot = 2.0 * deg, 0.02 * deg

    base = body(stage, ROOT + "/PortBase", 0.0, 0.0, r, 0.01)
    joint(stage, ROOT + "/J_world", "fixed", None, base, tuple(O), (0, 0, 0))   # world side = the port
    q = Gf.Matrix4d(*Rm[0], 0, *Rm[1], 0, *Rm[2], 0, 0, 0, 0, 1).ExtractRotation().GetQuat()
    UsdPhysics.FixedJoint.Get(stage, ROOT + "/J_world").CreateLocalRot0Attr().Set(Gf.Quatf(q))
    pivot = body(stage, ROOT + "/Pivot", 0.0, 0.0, r, 0.005)
    pa, pb = first["pivot"]
    piv = junction(stage, ROOT + "/J_pivot", base, pivot, 0.0, 0.0, k_neck * 20, c_neck * 20,
                   math.degrees(pa), math.degrees(pb))
    car = body(stage, ROOT + "/Carriage", tail, 0.0, r, 0.005)
    push = joint(stage, ROOT + "/J_push", "prismatic", pivot, car, (0, tail, 0), (0, 0, 0), "Y",
                 ("linear", k_push, c_push, float(first["lam"])))
    J = stage.GetPrimAtPath(ROOT + "/J_push")
    UsdPhysics.PrismaticJoint(J).CreateLowerLimitAttr(-0.05)
    UsdPhysics.PrismaticJoint(J).CreateUpperLimitAttr(1.0)

    tubes = [body(stage, f"{ROOT}/Tube_{i:02d}", tail + (i + 1) * Lt, Lt, r, w * Lt, (0.12, 0.12, 0.12))
             for i in range(nt)]
    rot = joint(stage, ROOT + "/J_rotate", "revolute", car, tubes[0], (0, 0, 0), (0, -Lt, 0), "Y",
                ("angular", k_rot, c_rot, math.degrees(first["roll"])))
    for i in range(nt - 1):
        junction(stage, f"{ROOT}/J_tube_{i:02d}", tubes[i], tubes[i + 1], Lt, tail + (i + 1) * Lt, k_tube, c_tube)

    necks = [body(stage, f"{ROOT}/Neck_{j:02d}", (j + 1) * Ln, Ln, r, w * Ln, (0.45, 0.45, 0.48))
             for j in range(NECK_SEGMENTS)]
    head = body(stage, ROOT + "/Head", NECK_LENGTH_MM / 1000.0 + L_head, L_head, r, 0.002, (0.75, 0.75, 0.78),
                geom="cylinder")
    links = [tubes[-1]] + necks + [head]
    neck_attrs = []
    for j in range(NECK_SEGMENTS + 1):
        a, b = first["neck"][j]
        child_len = Ln if j < NECK_SEGMENTS else L_head
        neck_attrs.append(junction(stage, f"{ROOT}/J_neck_{j:02d}", links[j], links[j + 1], child_len, j * Ln,
                                   k_neck, c_neck, math.degrees(a), math.degrees(b)))

    cam_path = ROOT + "/Head/TipCamera"
    cam = UsdGeom.Camera.Define(stage, cam_path)     # looks down -Z: turn it to look along +Y (probe axis)
    cam.AddRotateXOp().Set(90.0)
    W, H = C.CAM_RES                                 # calibrated camera, same as borescope_setup
    cam.CreateHorizontalApertureAttr(20.955)
    cam.CreateVerticalApertureAttr(20.955 * H / W)
    cam.CreateFocalLengthAttr(C.FX * 20.955 / W)
    cam.CreateClippingRangeAttr(Gf.Vec2f(0.0005, 3.0))
    UsdGeom.Imageable(cam).MakeInvisible()          # hides the big camera icon; you can still look through it
    print(f"[probe] camera: {S.apply_distortion(stage, cam_path)}")
    led = UsdLux.DiskLight.Define(stage, cam_path + "/LED")
    led.CreateRadiusAttr(0.0015)
    led.CreateIntensityAttr(C.LED_INTENSITY)
    led.CreateExposureAttr(C.LED_EXPOSURE)
    led.CreateNormalizeAttr(True)
    led.CreateEnableColorTemperatureAttr(True)
    led.CreateColorTemperatureAttr(6500.0)
    sh = UsdLux.ShapingAPI.Apply(led.GetPrim())
    sh.CreateShapingConeAngleAttr(C.LED_CONE_DEG)
    sh.CreateShapingConeSoftnessAttr(0.3)
    led.AddTranslateOp().Set(Gf.Vec3d(0, 0, 0.00005))
    carb.settings.get_settings().set("/rtx/post/histogram/enabled", True)   # auto exposure
    collar = UsdGeom.Cylinder.Define(stage, ROOT + "/PortCollar")        # visual only
    collar.CreateAxisAttr(UsdGeom.Tokens.y)
    collar.CreateRadiusAttr(r * 1.8)
    collar.CreateHeightAttr(0.01)
    collar.CreateDisplayColorAttr([Gf.Vec3f(1.0, 0.2, 0.2)])
    collar.CreateDisplayOpacityAttr([0.5])
    return push, rot, neck_attrs, piv


def curve(stage, path, P, color):
    c = UsdGeom.BasisCurves.Define(stage, path)
    c.CreateTypeAttr(UsdGeom.Tokens.linear)
    c.CreateCurveVertexCountsAttr(Vt.IntArray([len(P)]))
    c.CreatePointsAttr(Vt.Vec3fArray.FromNumpy(np.asarray(P, np.float32)))
    c.CreateWidthsAttr(Vt.FloatArray([0.0015]))
    c.SetWidthsInterpolation(UsdGeom.Tokens.constant)
    c.CreateDisplayColorAttr([Gf.Vec3f(*color)])


# =============================================================================
# RUN
# =============================================================================
def main():
    global C, S
    if SCRIPT_DIR not in sys.path:
        sys.path.insert(0, SCRIPT_DIR)
    for m in ("borescope_config", "borescope_setup"):
        importlib.reload(sys.modules[m]) if m in sys.modules else importlib.import_module(m)
    C, S = sys.modules["borescope_config"], sys.modules["borescope_setup"]
    old = getattr(builtins, "_jointed_probe_sub", None)
    if old is not None:
        builtins._jointed_probe_sub = None                 # dropping the subscription stops the old run
    tl = omni.timeline.get_timeline_interface()
    tl.stop()

    mod, bounds, kin = load_model()
    M = model_targets(bounds, kin)
    for name, ours in (("fixed_curvature_length_meters", NECK_LENGTH_MM), ("camera_distance_meters", CAMERA_LENGTH_MM)):
        v = getattr(mod, name, None)
        if v is not None and abs(v * 1000 - ours) > 1e-6:
            print(f"[probe] WARNING: model {name} = {v * 1000:.2f} mm, probe uses {ours:.2f} mm")

    stage = omni.usd.get_context().get_stage()
    if abs((UsdGeom.GetStageMetersPerUnit(stage) or 1.0) - 1.0) > 1e-9:
        print("[probe] WARNING: stage is not in metres; positions will be off")
    if not stage.GetPrimAtPath(C.PORT):
        print(f"[probe] ERROR: no {C.PORT} in the stage: open the engine first")
        return
    rig = S.Rig()                                    # port fit: origin, +Y into the engine, +Z up
    O, Rm = rig.O, np.stack([rig.X, rig.Y, rig.Z])   # rows = model x, y, z in world
    UsdGeom.Imageable(rig.port).MakeInvisible()      # the cutter sits in the hole
    if stage.GetPrimAtPath("/Borescope"):
        stage.RemovePrim("/Borescope")               # the static probe from main.py, if it is there
    to_world = lambda P: O + np.asarray(P, float) @ Rm
    print(f"[probe] port {C.PORT}: origin {np.round(O, 4).tolist()} | into the engine {np.round(rig.Y, 3).tolist()}")
    first = dict(lam=M["lam"][0], roll=M["roll"][0], neck=M["neck"][0], pivot=M["pivot"][0])
    push, rot, neck_attrs, piv_attrs = build(stage, first, (O, Rm))
    curve(stage, ROOT + "/ModelNeckPath", M["necks"], (0.0, 0.8, 0.2))
    curve(stage, ROOT + "/ModelCameraPath", M["cams"], (1.0, 0.2, 0.2))

    t, T = M["t"], M["t"][-1]
    N1 = NECK_SEGMENTS + 1
    nt = int(round(TUBE_LENGTH_MM / TUBE_LINK_MM))
    LINKS = dict(tail=f"Tube_{nt - 1:02d}", n0="Neck_00", nl=f"Neck_{NECK_SEGMENTS - 1:02d}", head="Head")
    # joint-direction self-check (PhysX decides which way a positive joint angle turns; we measure it)
    CAL = (("x", 0.0, 0.35), ("z", 0.35, 0.70), ("rot", 0.70, 1.05))
    rec = dict(k=0, neck=[], cam=[], done=False, backend=None, fails=0,
               sign=dict(x=1.0, z=1.0, rot=1.0), cal_done=set())
    physx = omni.physx.get_physx_interface()

    def model_at(tau):
        f = lambda arr: float(np.interp(tau, t, arr))
        return (f(M["lam"]), f(M["roll"]), (f(M["pivot"][:, 0]), f(M["pivot"][:, 1])),
                np.array([[f(M["neck"][:, j, c]) for c in (0, 1)] for j in range(N1)]))

    # ---------- backend 1: PhysX tensor API (fast) ----------
    def connect_tensors():
        import omni.physics.tensors as tensors
        try:
            sim = tensors.create_simulation_view("numpy", stage_id=omni.usd.get_context().get_stage_id())
        except TypeError:
            sim = tensors.create_simulation_view("numpy")
        sim.set_subspace_roots("/")
        art = sim.create_articulation_view(ROOT)
        mt = art.shared_metatype
        dof = {n: i for i, n in enumerate(mt.dof_names)}
        link = {n: i for i, n in enumerate(mt.link_names)}
        need = ["J_push", "J_rotate", "J_pivot_x", "J_pivot_z"] + [f"J_neck_{j:02d}_{c}" for j in range(N1) for c in "xz"]
        miss = [n for n in need if n not in dof] + [n for n in LINKS.values() if n not in link]
        if miss:
            raise RuntimeError(f"names not found {miss[:3]}; dofs {list(dof)[:4]}..., links {list(link)[:4]}...")
        base = art.get_dof_position_targets().copy()
        ix = dict(push=dof["J_push"], rot=dof["J_rotate"], px=dof["J_pivot_x"], pz=dof["J_pivot_z"],
                  nx=[dof[f"J_neck_{j:02d}_x"] for j in range(N1)], nz=[dof[f"J_neck_{j:02d}_z"] for j in range(N1)])
        li = {k: link[v] for k, v in LINKS.items()}

        def send(lam, roll, pv, ab):
            sg = rec["sign"]
            tg = base.copy()
            tg[0, ix["push"]] = lam
            tg[0, ix["rot"]] = sg["rot"] * roll
            tg[0, ix["px"]], tg[0, ix["pz"]] = sg["x"] * pv[0], sg["z"] * pv[1]
            tg[0, ix["nx"]] = sg["x"] * ab[:, 0]
            tg[0, ix["nz"]] = sg["z"] * ab[:, 1]
            art.set_dof_position_targets(tg.astype(np.float32), np.array([0], dtype=np.int32))

        def where():
            P = np.asarray(art.get_link_transforms())[0, :, :3]
            return {k: P[i].copy() for k, i in li.items()}
        return dict(name="PhysX tensors", send=send, where=where, keep=sim)

    # ---------- backend 2: USD drive targets (works everywhere) ----------
    def connect_usd():
        deg = math.degrees

        def send(lam, roll, pv, ab):
            sg = rec["sign"]
            with Sdf.ChangeBlock():
                push.Set(float(lam))
                rot.Set(deg(sg["rot"] * roll))
                piv_attrs[0].Set(deg(sg["x"] * pv[0]))
                piv_attrs[1].Set(deg(sg["z"] * pv[1]))
                for j, (ax, az) in enumerate(neck_attrs):
                    ax.Set(deg(sg["x"] * ab[j, 0]))
                    az.Set(deg(sg["z"] * ab[j, 1]))

        def where():
            out = {}
            for k, v in LINKS.items():
                q = physx.get_rigidbody_transformation(f"{ROOT}/{v}")["position"]
                out[k] = np.array([q[0], q[1], q[2]], float)
            return out
        return dict(name="USD drive targets", send=send, where=where)

    def report():
        en = np.linalg.norm(np.array(rec["neck"]) - to_world(M["necks"]), axis=1) * 1000
        ec = np.linalg.norm(np.array(rec["cam"]) - to_world(M["cams"]), axis=1) * 1000
        print("\n================ JOINTED PROBE vs MODEL ================")
        print(f"profile '{PROFILE}', {len(t)} steps, gravity {'ON' if GRAVITY else 'OFF'}, via {rec['backend']['name']}")
        print(f"neck end : max {en.max():.3f} mm   rms {np.sqrt(np.mean(en ** 2)):.3f} mm   final {en[-1]:.3f} mm")
        print(f"camera   : max {ec.max():.3f} mm   rms {np.sqrt(np.mean(ec ** 2)):.3f} mm   final {ec[-1]:.3f} mm")
        print("=========================================================")

    def on_update(_):
        try:
            if not tl.is_playing():                  # stopped / paused: never touch the physics
                if rec["backend"] is not None and tl.get_current_time() <= 1e-6:
                    rec.update(k=0, neck=[], cam=[], done=False, backend=None, fails=0, cal_done=set())
                return
            if rec["backend"] is None:
                try:
                    rec["backend"] = connect_tensors()
                except Exception as e:
                    rec["fails"] += 1
                    if rec["fails"] < 10:
                        return                       # physics may need a few frames to start
                    print(f"[probe] tensor API not available ({e}); using USD drive targets")
                    rec["backend"] = connect_usd()
                print(f"[probe] driving the joints via {rec['backend']['name']}")
            B = rec["backend"]
            now = tl.get_current_time()
            lam0, roll0, pv0, ab0 = model_at(0.0)
            # ---- self-check: bend one joint at a time (pivot straight) and see where the first neck link goes
            for name, a, b in CAL:
                if a <= now < b:
                    ab = np.zeros((N1, 2))
                    ab[0] = (0.3, 0.0) if name in ("x", "rot") else (0.0, 0.3)
                    B["send"](lam0, 0.4 if name == "rot" else 0.0, (0.0, 0.0), ab)
                    return
                if now >= b and name not in rec["cal_done"]:
                    P = B["where"]()
                    d = Rm @ (P["n0"] - P["tail"])          # in the port (model) frame
                    sg = rec["sign"]
                    if name == "x":
                        sg["x"] = 1.0 if d[2] > 0 else -1.0          # +X bend must lift the link toward +Z
                    elif name == "z":
                        sg["z"] = 1.0 if d[0] < 0 else -1.0          # +Z bend must swing it toward -X
                    else:
                        sg["rot"] = 1.0 if d[0] > 0 else -1.0        # +roll must turn the +Z bend toward +X
                        print(f"[probe] joint directions measured: X {sg['x']:+.0f}, Z {sg['z']:+.0f}, "
                              f"roll {sg['rot']:+.0f}")
                    rec["cal_done"].add(name)
            # ---- the model profile
            tau = min(max(now - HOLD_S, 0.0), T)
            B["send"](*model_at(tau))
            if now >= HOLD_S:
                P = None
                while rec["k"] < len(t) and tau >= t[rec["k"]] - 1e-9:
                    P = B["where"]() if P is None else P
                    rec["neck"].append(P["nl"])
                    rec["cam"].append(P["head"])
                    rec["k"] += 1
                if rec["k"] == len(t) and not rec["done"]:
                    rec["done"] = True
                    report()
        except Exception as e:                       # never let the callback take Isaac down
            print(f"[probe] update skipped: {e}")

    builtins._jointed_probe_sub = omni.kit.app.get_app().get_update_event_stream().create_subscription_to_pop(
        on_update, name="jointed_probe")
    tl.set_start_time(0.0)
    tl.set_end_time(HOLD_S + T + 5.0)
    tl.set_looping(False)
    tl.set_current_time(0.0)

    print("\n================ JOINTED PROBE ================")
    print(f"profile '{PROFILE}': {len(t)} steps, {T:.2f} s (starts after {HOLD_S:.1f} s self-check + hold)")
    print(f"push {M['lam'][0] * 1000:.1f} -> {M['lam'][-1] * 1000:.1f} mm, "
          f"pivot at the port up to {np.degrees(np.abs(M['pivot'])).max():.1f} deg, "
          f"roll {math.degrees(M['roll'][0]):.1f} -> {math.degrees(M['roll'][-1]):.1f} deg")
    print(f"model check: neck start off the pivoted tube line max {M['off'].max() * 1000:.3f} mm, "
          f"kink tube -> neck max {M['kink'].max():.2f} deg  (both should be ~0)")
    if VIEW_FROM_TIP:
        try:
            from omni.kit.viewport.utility import get_active_viewport
            get_active_viewport().camera_path = ROOT + "/Head/TipCamera"
        except Exception as e:
            print(f"[probe] pick the camera by hand (Camera menu > PortProbe > TipCamera): {e}")
    tl.play()


main()
