import numpy as np
import omni.kit.app
import omni.physx
import omni.timeline
import omni.usd
from pxr import Gf, PhysxSchema, Sdf, UsdGeom, UsdLux, UsdPhysics, UsdShade, Vt
import sys
import importlib
import carb
C = S = None                    # borescope_config / borescope_setup, loaded in main() from SCRIPT_DIR

