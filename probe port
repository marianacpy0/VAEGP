# MODEL -> TARGETS
# =============================================================================
def load_model():
    if SOURCE == "accel":
        import accel_profile
        importlib.reload(accel_profile)
        fk = None
        if ACCEL_H1 == "model":
            mod, bounds, _ = load_your_model()
            fk = accel_profile.model_fk(mod, bounds)
        kin = accel_profile.AccelKinematics(sigma=NECK_LENGTH_MM / 1000.0, l=CAMERA_LENGTH_MM / 1000.0, fk=fk)
        return accel_profile, {}, kin
    return load_your_model()


def load_your_model():
    """Your spatial_borescope_model.py with its PROFILE -> (module, bounds, kinematics)."""
    spec = importlib.util.spec_from_file_location("spatial_borescope_model", MODEL_PY)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    if hasattr(mod, "motion_profile"):
        mod.motion_profile = PROFILE
    # the model script starts its own viewer animation when loaded: switch it off (it writes the stage every frame)
    if hasattr(mod, "stop_animation"):
        mod.stop_animation = True
    for name in dir(mod):
        if "sub" in name.lower() and not name.startswith("__") and not callable(getattr(mod, name)):
            setattr(mod, name, None)
    bounds = mod.resolve_motion_profile(PROFILE)
    for make in (lambda: mod.BorescopeKinematics(bounds), lambda: mod.BorescopeKinematics(**bounds),
                 lambda: mod.BorescopeKinematics(PROFILE)):
        try:
            return mod, bounds, make()
        except TypeError:
            pass
    raise TypeError("Could not create BorescopeKinematics: change the 3 calls in load_model().")


def unit(v):
    n = np.linalg.norm(v)
    return v / n if n > 1e-12 else v


def Rx(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[1, 0, 0], [0, c, -s], [0, s, c]])


def Ry(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, 0, s], [0, 1, 0], [-s, 0, c]])


def Rz(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, -s, 0], [s, c, 0], [0, 0, 1]])


def resample(P, n):
    s = np.r_[0.0, np.cumsum(np.linalg.norm(np.diff(P, axis=0), axis=1))]
    u = np.linspace(0.0, s[-1], n + 1)
    return np.stack([np.interp(u, s, P[:, k]) for k in range(3)], 1)


def tilt_angles(d, F):
    """X-then-Z revolute angles that turn frame F so its +Y axis points along d. Returns (a, b, new F)."""
    t = F.T @ d
    b = -math.asin(float(np.clip(t[0], -1, 1)))
    a = math.atan2(t[2], t[1])
    return a, b, F @ Rx(a) @ Rz(b)


def joint_targets(arc, start, neck_end, cam, roll):
    """Pivot angles at the port, push length, and the neck joint angles that put every neck link along the
    model's arc and the head on the model's camera. Solved link by link in the actual parent frame."""
    A = np.asarray(arc, float)
    T0 = unit(-3 * A[0] + 4 * A[1] - A[2])            # neck start tangent
    u = unit(start) if np.linalg.norm(start) > 2e-3 else T0   # tube direction: port -> neck start
    pa, pb, F = tilt_angles(u, np.eye(3))
    lam = float(np.dot(start, u))
    F = F @ Ry(roll)
    pts = resample(A, NECK_SEGMENTS)
    dirs = [unit(b - a) for a, b in zip(pts[:-1], pts[1:])] + [unit(cam - neck_end)]
    neck = []
    for d in dirs:
        a, b, F = tilt_angles(d, F)
        neck.append((a, b))
    kink = math.degrees(math.acos(float(np.clip(np.dot(u, T0), -1, 1))))
    off = float(np.linalg.norm(np.cross(start, u)))
    return (pa, pb), lam, neck, kink, off


def model_targets(bounds, kin):
    t = np.asarray(kin.simulation_time_seconds, float)
    start = np.asarray(kin.neck_translation_position_meters, float)
    arcs = np.asarray(kin.probe_sector_points_meters, float)
    necks = np.asarray(kin.neck_position_meters, float)
    cams = np.asarray(kin.camera_position_meters, float)
    # roll follows the same time law as the insertion (recovered from the insertion length)
    if hasattr(kin, "roll_rad"):                      # accel_profile: beta(t) comes from the integration
        roll = np.asarray(kin.roll_rad, float)
    else:
        lam_n = np.linalg.norm(start, axis=1)
        l0, l1 = bounds["initial_y_translation_meters"], bounds["final_y_translation_meters"]
        s = np.clip((lam_n - l0) / (l1 - l0), 0, 1) if abs(l1 - l0) > 1e-12 else np.zeros_like(lam_n)
        r0, r1 = bounds["initial_roll_angle_rad"], bounds["final_roll_angle_rad"]
        roll = r0 + (r1 - r0) * s
    R = [joint_targets(arcs[i], start[i], necks[i], cams[i], roll[i]) for i in range(len(t))]
    return dict(t=t, roll=roll, pivot=np.array([r[0] for r in R]), lam=np.array([r[1] for r in R]),
                neck=np.array([r[2] for r in R]), kink=np.array([r[3] for r in R]),
                off=np.array([r[4] for r in R]), necks=necks, cams=cams)


# =============================================================================
# BUILD (all lengths in metres; stage assumed in metres)
# =============================================================================
def body(stage, path, end_y, length, radius, mass, color=None, geom="capsule"):
    """Rigid link whose ORIGIN is its far end (so its position = the point we measure)."""
    x = UsdGeom.Xform.Define(stage, path)
    x.AddTranslateOp().Set(Gf.Vec3d(0.0, end_y, 0.0))
    p = x.GetPrim()
    UsdPhysics.RigidBodyAPI.Apply(p)
    m = UsdPhysics.MassAPI.Apply(p)
    m.CreateMassAttr(mass)
    m.CreateCenterOfMassAttr(Gf.Vec3f(0.0, -length / 2, 0.0))
    ia = mass * (3 * radius ** 2 + length ** 2) / 12.0
    m.CreateDiagonalInertiaAttr(Gf.Vec3f(max(ia, 1e-10), max(mass * radius ** 2 / 2.0, 1e-10), max(ia, 1e-10)))
    rb = PhysxSchema.PhysxRigidBodyAPI.Apply(p)
    rb.CreateDisableGravityAttr(True)                    # kinematics only (see the top of the file)
    rb.CreateLinearDampingAttr(0.5)
    rb.CreateAngularDampingAttr(0.5)
    if color is not None and length > 0:
        g = (UsdGeom.Capsule if geom == "capsule" else UsdGeom.Cylinder).Define(stage, path + "/geom")
        g.CreateAxisAttr(UsdGeom.Tokens.y)
        g.CreateRadiusAttr(radius)
        g.CreateHeightAttr(length)                  # capsules overlap a little -> smooth cable
        g.CreateDisplayColorAttr([Gf.Vec3f(*color)])
        g.AddTranslateOp().Set(Gf.Vec3d(0.0, -length / 2, 0.0))
    return p


def joint(stage, path, kind, b0, b1, pos0, pos1, axis=None, drive=None):
    J = {"fixed": UsdPhysics.FixedJoint, "prismatic": UsdPhysics.PrismaticJoint,
         "revolute": UsdPhysics.RevoluteJoint}[kind].Define(stage, path)
    if b0 is not None:
        J.CreateBody0Rel().SetTargets([b0.GetPath()])
    J.CreateBody1Rel().SetTargets([b1.GetPath()])
    J.CreateLocalPos0Attr(Gf.Vec3f(*pos0))
    J.CreateLocalPos1Attr(Gf.Vec3f(*pos1))
    J.CreateLocalRot0Attr(Gf.Quatf(1.0))
    J.CreateLocalRot1Attr(Gf.Quatf(1.0))
    if axis:
        J.CreateAxisAttr(axis)
    if drive:
        name, k, c, target = drive
        d = UsdPhysics.DriveAPI.Apply(J.GetPrim(), name)
        d.CreateTypeAttr("force")
        d.CreateStiffnessAttr(k)
        d.CreateDampingAttr(c)
        return d.CreateTargetPositionAttr(target)
    return None


def junction(stage, path, parent, child, child_len, spacer_y, k_deg, c_deg, a0=0.0, b0=0.0):
    """Two revolute joints (X then Z) through a tiny spacer body = a bending joint with 2 axes."""
    sp = body(stage, path + "_spacer", spacer_y, 0.0, 1e-3, 1e-4)
    ax = joint(stage, path + "_x", "revolute", parent, sp, (0, 0, 0), (0, 0, 0), "X", ("angular", k_deg, c_deg, a0))
    az = joint(stage, path + "_z", "revolute", sp, child, (0, 0, 0), (0, -child_len, 0), "Z", ("angular", k_deg, c_deg, b0))
    return ax, az


def build(stage, first, port):
    if stage.GetPrimAtPath(ROOT):
        stage.RemovePrim(ROOT)
    O, Rm = port
    rx = UsdGeom.Xform.Define(stage, ROOT)                   # the model frame, sitting on the port
    rx.AddTransformOp().Set(Gf.Matrix4d(*Rm[0], 0, *Rm[1], 0, *Rm[2], 0, *O, 1))
    root = rx.GetPrim()
    UsdPhysics.ArticulationRootAPI.Apply(root)
    art = PhysxSchema.PhysxArticulationAPI.Apply(root)
    art.CreateEnabledSelfCollisionsAttr(False)
    art.CreateSolverPositionIterationCountAttr(16)
    art.CreateSolverVelocityIterationCountAttr(4)

    if not any(p.IsA(UsdPhysics.Scene) for p in stage.Traverse()):
        sc = UsdPhysics.Scene.Define(stage, "/World/physicsScene")
        sc.CreateGravityDirectionAttr(Gf.Vec3f(0, 0, -1))
        sc.CreateGravityMagnitudeAttr(9.81)
    for p in stage.Traverse():
        if p.IsA(UsdPhysics.Scene):
            PhysxSchema.PhysxSceneAPI.Apply(p).CreateTimeStepsPerSecondAttr(PHYSICS_HZ)

    r = CABLE_DIAMETER_MM / 2000.0
    w = MASS_PER_M_G / 1000.0
    Lt, nt = TUBE_LINK_MM / 1000.0, int(round(TUBE_LENGTH_MM / TUBE_LINK_MM))
    Ln, L_head = NECK_LENGTH_MM / 1000.0 / NECK_SEGMENTS, CAMERA_LENGTH_MM / 1000.0
    tail = -nt * Lt
    deg = math.pi / 180.0
    k_tube = EI_OVER_W_M3 * w * 9.81 / Lt * deg            # passive bending spring  [N m / deg]
    c_tube = k_tube * 0.004
    k_neck, c_neck = 2.0 * deg, 0.02 * deg                 # stiff position drives on the neck
    k_push, c_push = 4000.0, 40.0
    k_rot, c_rot = 2.0 * deg, 0.02 * deg

    base = body(stage, ROOT + "/PortBase", 0.0, 0.0, r, 0.01)
    joint(stage, ROOT + "/J_world", "fixed", None, base, tuple(O), (0, 0, 0))   # world side = the port
    q = Gf.Matrix4d(*Rm[0], 0, *Rm[1], 0, *Rm[2], 0, 0, 0, 0, 1).ExtractRotation().GetQuat()
    UsdPhysics.FixedJoint.Get(stage, ROOT + "/J_world").CreateLocalRot0Attr().Set(Gf.Quatf(q))
    pivot = body(stage, ROOT + "/Pivot", 0.0, 0.0, r, 0.005)
    pa, pb = first["pivot"]
    piv = junction(stage, ROOT + "/J_pivot", base, pivot, 0.0, 0.0, k_neck * 20, c_neck * 20,
                   math.degrees(pa), math.degrees(pb))
    car = body(stage, ROOT + "/Carriage", tail, 0.0, r, 0.005)
    push = joint(stage, ROOT + "/J_push", "prismatic", pivot, car, (0, tail, 0), (0, 0, 0), "Y",
                 ("linear", k_push, c_push, float(first["lam"])))
    J = stage.GetPrimAtPath(ROOT + "/J_push")
    UsdPhysics.PrismaticJoint(J).CreateLowerLimitAttr(-0.05)
    UsdPhysics.PrismaticJoint(J).CreateUpperLimitAttr(1.0)

    tubes = [body(stage, f"{ROOT}/Tube_{i:02d}", tail + (i + 1) * Lt, Lt, r, w * Lt, (0.12, 0.12, 0.12))
             for i in range(nt)]
    rot = joint(stage, ROOT + "/J_rotate", "revolute", car, tubes[0], (0, 0, 0), (0, -Lt, 0), "Y",
                ("angular", k_rot, c_rot, math.degrees(first["roll"])))
    for i in range(nt - 1):
        junction(stage, f"{ROOT}/J_tube_{i:02d}", tubes[i], tubes[i + 1], Lt, tail + (i + 1) * Lt, k_tube, c_tube)

    necks = [body(stage, f"{ROOT}/Neck_{j:02d}", (j + 1) * Ln, Ln, r, w * Ln, (0.45, 0.45, 0.48))
             for j in range(NECK_SEGMENTS)]
    head = body(stage, ROOT + "/Head", NECK_LENGTH_MM / 1000.0 + L_head, L_head, r, 0.002, (0.75, 0.75, 0.78),
                geom="cylinder")
    links = [tubes[-1]] + necks + [head]
    neck_attrs = []
    for j in range(NECK_SEGMENTS + 1):
        a, b = first["neck"][j]
        child_len = Ln if j < NECK_SEGMENTS else L_head
        neck_attrs.append(junction(stage, f"{ROOT}/J_neck_{j:02d}", links[j], links[j + 1], child_len, j * Ln,
                                   k_neck, c_neck, math.degrees(a), math.degrees(b)))

    cam_path = ROOT + "/Head/TipCamera"
    cam = UsdGeom.Camera.Define(stage, cam_path)     # looks down -Z: turn it to look along +Y (probe axis)
    cam.AddTranslateOp().Set(Gf.Vec3d(0.0, 0.0002, 0.0))   # 0.2 mm ahead of the head's end face
    cam.AddRotateXOp().Set(90.0)
    cam.AddRotateZOp().Set(CAMERA_ROLL_DEG)            # roll about the view axis
    W, H = C.CAM_RES                                 # calibrated camera, same as borescope_setup
    cam.CreateHorizontalApertureAttr(20.955)
    cam.CreateVerticalApertureAttr(20.955 * H / W)
    cam.CreateFocalLengthAttr(C.FX * 20.955 / W)
    cam.CreateClippingRangeAttr(Gf.Vec2f(0.0005, 3.0))
    UsdGeom.Imageable(cam).MakeInvisible()          # hides the big camera icon; you can still look through it
    print(f"[probe] camera: {S.apply_distortion(stage, cam_path)}")
    # LED: on the head (next to the camera, not inside it), facing along the probe like the camera
    led = UsdLux.DiskLight.Define(stage, ROOT + "/Head/LED")
    led.AddTranslateOp().Set(Gf.Vec3d(0.0, 0.0001, 0.0))      # 0.1 mm ahead of the head's end face
    led.AddRotateXOp().Set(90.0)                              # emits along -Z -> along the probe (+Y)
    led.CreateRadiusAttr(0.0015)
    led.CreateIntensityAttr(C.LED_INTENSITY * LED_GAIN)
    led.CreateExposureAttr(C.LED_EXPOSURE)
    led.CreateNormalizeAttr(True)
    led.CreateEnableColorTemperatureAttr(True)
    led.CreateColorTemperatureAttr(6500.0)
    sh = UsdLux.ShapingAPI.Apply(led.GetPrim())
    sh.CreateShapingConeAngleAttr(C.LED_CONE_DEG)
    sh.CreateShapingConeSoftnessAttr(0.3)
    glow = UsdGeom.Cylinder.Define(stage, ROOT + "/Head/LEDGlow")   # small lit disc so you can see the LED
    glow.CreateAxisAttr(UsdGeom.Tokens.y)
    glow.CreateRadiusAttr(CABLE_DIAMETER_MM / 2000.0 * 0.6)
    glow.CreateHeightAttr(0.0001)
    glow.AddTranslateOp().Set(Gf.Vec3d(0.0, 0.00005, 0.0))
    mat = UsdShade.Material.Define(stage, ROOT + "/Head/LEDGlowMat")
    shd = UsdShade.Shader.Define(stage, ROOT + "/Head/LEDGlowMat/Shader")
    shd.CreateIdAttr("UsdPreviewSurface")
    shd.CreateInput("diffuseColor", Sdf.ValueTypeNames.Color3f).Set(Gf.Vec3f(1.0, 1.0, 0.95))
    shd.CreateInput("emissiveColor", Sdf.ValueTypeNames.Color3f).Set(Gf.Vec3f(1.0, 1.0, 0.9))
    mat.CreateSurfaceOutput().ConnectToSource(shd.ConnectableAPI(), "surface")
    UsdShade.MaterialBindingAPI.Apply(glow.GetPrim()).Bind(mat)
    carb.settings.get_settings().set("/rtx/post/histogram/enabled", True)   # auto exposure
    collar = UsdGeom.Cylinder.Define(stage, ROOT + "/PortCollar")        # visual only
    collar.CreateAxisAttr(UsdGeom.Tokens.y)
    collar.CreateRadiusAttr(r * 1.8)
    collar.CreateHeightAttr(0.01)
    collar.CreateDisplayColorAttr([Gf.Vec3f(1.0, 0.2, 0.2)])
    collar.CreateDisplayOpacityAttr([0.5])
    return push, rot, neck_attrs, piv


# =============================================================================
# CAMERA POSE (for SLAM)
#   T = 4x4 numpy, column-vector convention: p_parent = T @ [p_cam, 1]
#   Camera axes are OpenCV: x right, y down, z forward (the calibrated K / distortion apply directly).
#   T_port : camera in the port (model) frame: origin at the port, +Y into the engine, +Z up
#   T_world: camera in the stage world frame
# =============================================================================
POSES = []        # one dict per rendered frame while playing: {"time", "T_port", "T_world"}


def get_poses():
    """All poses so far -> (times (N,), T_port (N,4,4), T_world (N,4,4))."""
    if not POSES:
        return np.zeros(0), np.zeros((0, 4, 4)), np.zeros((0, 4, 4))
    return (np.array([p["time"] for p in POSES]), np.stack([p["T_port"] for p in POSES]),
            np.stack([p["T_world"] for p in POSES]))


def latest_pose():
    """Most recent pose dict, or None."""
    return POSES[-1] if POSES else None


def quat_R(w, x, y, z):
    n = math.sqrt(w * w + x * x + y * y + z * z) or 1.0
    w, x, y, z = w / n, x / n, y / n, z / n
    return np.array([[1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
                     [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
                     [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)]])


def head_to_camera_cv():
    """Fixed transform Head body -> camera (OpenCV axes), the same ops as the TipCamera prim."""
    def rot4(R):
        M = np.eye(4)
        M[:3, :3] = R
        return M
    T = np.eye(4)
    T[1, 3] = 0.0002                                           # translate 0.2 mm along the head
    a, r = math.radians(90.0), math.radians(CAMERA_ROLL_DEG)
    Rx = np.array([[1, 0, 0], [0, math.cos(a), -math.sin(a)], [0, math.sin(a), math.cos(a)]])
    Rz = np.array([[math.cos(r), -math.sin(r), 0], [math.sin(r), math.cos(r), 0], [0, 0, 1]])
    return T @ rot4(Rx) @ rot4(Rz) @ np.diag([1.0, -1.0, -1.0, 1.0])   # USD camera -> OpenCV axes


def look_at(eye, target, up, roll_deg=0.0):
    """USD camera transform (row-vector Gf matrix) at eye, looking at target, with up as close to up as possible,
    then turned by roll_deg about the view axis."""
    f = unit(np.asarray(target, float) - np.asarray(eye, float))
    z = -f                                             # USD cameras look down -Z
    x = np.cross(up, z)
    if np.linalg.norm(x) < 1e-6:
        x = np.cross([1.0, 0.0, 0.0], z)
    x = unit(x)
    y = np.cross(z, x)
    if roll_deg:
        a = math.radians(roll_deg)
        x, y = math.cos(a) * x + math.sin(a) * y, -math.sin(a) * x + math.cos(a) * y
    return Gf.Matrix4d(*x, 0, *y, 0, *z, 0, *np.asarray(eye, float), 1)


def engine_triangles(stage, center, radius, mpu=1.0):
    """World triangles (A, B, C) of every visible engine mesh within radius of center (probes and cutters skipped)."""
    xfc = UsdGeom.XformCache()
    out = []
    for p in Usd.PrimRange(stage.GetPseudoRoot()):
        if not p.IsA(UsdGeom.Mesh):
            continue
        path = str(p.GetPath())
        if path.startswith(ROOT) or "cutter" in path.lower():
            continue
        if UsdGeom.Imageable(p).ComputeVisibility() == UsdGeom.Tokens.invisible:
            continue
        m = UsdGeom.Mesh(p)
        P, cnt, idx = m.GetPointsAttr().Get(), m.GetFaceVertexCountsAttr().Get(), m.GetFaceVertexIndicesAttr().Get()
        if not P or not cnt or not idx:
            continue
        X = xfc.GetLocalToWorldTransform(p)
        X = np.array([[X[i][j] for j in range(4)] for i in range(4)])
        W = (np.hstack([np.asarray(P, float), np.ones((len(P), 1))]) @ X)[:, :3] * mpu
        lo, hi = W.min(0), W.max(0)
        if np.linalg.norm(np.maximum(0.0, np.maximum(lo - center, center - hi))) > radius:
            continue                                     # whole mesh too far away
        cnt, idx = np.asarray(cnt), np.asarray(idx)
        start = np.r_[0, np.cumsum(cnt)[:-1]]
        for k in range(1, int(cnt.max()) - 1):           # fan-triangulate every face
            f = cnt > k + 1
            tri = np.stack([idx[start[f]], idx[start[f] + k], idx[start[f] + k + 1]], 1)
            T = W[tri]
            near = np.linalg.norm(T.mean(1) - center, axis=1) < radius
            if near.any():
                out.append(T[near])
    T = np.concatenate(out) if out else np.zeros((0, 3, 3))
    return T[:, 0], T[:, 1], T[:, 2]


def prep_tris(A, B, C):
    """Triangles + their bounding boxes, ready for many segment tests."""
    A, B, C = (np.asarray(x, float) for x in (A, B, C))
    return dict(A=A, e1=B - A, e2=C - A, lo=np.minimum(np.minimum(A, B), C), hi=np.maximum(np.maximum(A, B), C))


def segment_blocked(o, q, T, stop=0.97):
    """True if the straight segment o -> (most of the way to) q crosses any triangle of T (from prep_tris)."""
    if len(T["A"]) == 0:
        return False
    qs = o + stop * (q - o)
    sel = np.all(T["hi"] >= np.minimum(o, qs), 1) & np.all(T["lo"] <= np.maximum(o, qs), 1)   # boxes that touch
    if not sel.any():
        return False
    A, e1, e2 = T["A"][sel], T["e1"][sel], T["e2"][sel]
    d = q - o
    h = np.cross(d, e2)
    a = (e1 * h).sum(1)
    ok = np.abs(a) > 1e-14
    f = np.where(ok, 1.0 / np.where(ok, a, 1.0), 0.0)
    s = o - A
    u = f * (s * h).sum(1)
    qq = np.cross(s, e1)
    v = f * (qq @ d)
    t = f * (qq * e2).sum(1)
    return bool(np.any(ok & (u >= 0) & (v >= 0) & (u + v <= 1) & (t > 1e-4) & (t < stop)))


def point_triangle_dist(p, T):
    """Distance from point p to every triangle of T (from prep_tris)."""
    A, e1, e2 = T["A"], T["e1"], T["e2"]
    n = np.cross(e1, e2)
    nn = np.linalg.norm(n, axis=1)
    ok = nn > 1e-15
    n = n / np.where(ok, nn, 1.0)[:, None]
    w = p - A
    dpl = (w * n).sum(1)
    q = w - dpl[:, None] * n                               # projection onto the plane, relative to A
    d00, d01, d11 = (e1 * e1).sum(1), (e1 * e2).sum(1), (e2 * e2).sum(1)
    d20, d21 = (q * e1).sum(1), (q * e2).sum(1)
    den = np.where(ok, d00 * d11 - d01 * d01, 1.0)
    v = (d11 * d20 - d01 * d21) / den
    u = (d00 * d21 - d01 * d20) / den
    inside = ok & (v >= 0) & (u >= 0) & (u + v <= 1)

    def seg(a, b):                                          # distance from p to segments a -> b
        ab = b - a
        t = np.clip(((p - a) * ab).sum(1) / np.maximum((ab * ab).sum(1), 1e-30), 0, 1)
        return np.linalg.norm(p - (a + t[:, None] * ab), axis=1)
    B, C = A + e1, A + e2
    edge = np.minimum(np.minimum(seg(A, B), seg(B, C)), seg(C, A))
    return np.where(inside, np.abs(dpl), edge)


def clearance(stage, kin, M, to_world, n_times=60):
    """Closest approach of the PLANNED probe (neck arc, neck end, camera) to the engine, before playing."""
    t = np.asarray(kin.simulation_time_seconds, float)
    arcs = np.asarray(kin.probe_sector_points_meters, float)
    idx = np.unique(np.linspace(0, len(t) - 1, min(n_times, len(t))).astype(int))
    pts, tag = [], []
    for i in idx:
        a = arcs[i][np.linspace(0, len(arcs[i]) - 1, 6).astype(int)]
        for k, q in enumerate(list(a) + [np.asarray(kin.camera_position_meters[i], float)]):
            pts.append(q)
            tag.append((float(t[i]), "camera" if k == len(a) else "neck"))
    P = to_world(np.array(pts))
    c = 0.5 * (P.min(0) + P.max(0))
    T = prep_tris(*engine_triangles(stage, c, np.linalg.norm(P - c, axis=1).max() + 0.03))
    if len(T["A"]) == 0:
        return None
    lo, hi = T["lo"], T["hi"]
    best = (np.inf, None)
    for p, tg in zip(P, tag):
        near = np.all(hi >= p - 0.03, 1) & np.all(lo <= p + 0.03, 1)    # triangles within 30 mm (box test)
        if not near.any():
            continue
        sub = {k: v[near] for k, v in T.items()}
        d = point_triangle_dist(p, sub).min()
        if d < best[0]:
            best = (d, tg)
    return best


def build_observer(stage, root, eye, target, up):
    """Xform with an (invisible) camera. Returns (transform op, camera path)."""
    path = root + "Observer"
    if stage.GetPrimAtPath(path):
        stage.RemovePrim(path)
    x = UsdGeom.Xform.Define(stage, path)
    op = x.AddTransformOp()
    op.Set(look_at(eye, target, up))
    cam = UsdGeom.Camera.Define(stage, path + "/Camera")
    cam.CreateFocalLengthAttr(11.0)                       # wide (~87 deg horizontal)
    cam.CreateHorizontalApertureAttr(20.955)
    cam.CreateVerticalApertureAttr(20.955 * 9 / 16)
    cam.CreateClippingRangeAttr(Gf.Vec2f(0.001, 5.0))
    UsdGeom.Imageable(cam).MakeInvisible()                # no camera icon in the other views
    return op, path + "/Camera"


