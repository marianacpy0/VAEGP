# =============================================================================
# CAMERA POSE (for SLAM)
#   T = 4x4 numpy, column-vector convention: p_parent = T @ [p_cam, 1]
#   Camera axes are OpenCV: x right, y down, z forward (the calibrated K / distortion apply directly).
#   T_port : camera in the port (model) frame: origin at the port, +Y into the engine, +Z up
#   T_world: camera in the stage world frame
# =============================================================================
POSES = []        # one dict per rendered frame while playing: {"time", "T_port", "T_world"}


def get_poses():
    """All poses so far -> (times (N,), T_port (N,4,4), T_world (N,4,4))."""
    if not POSES:
        return np.zeros(0), np.zeros((0, 4, 4)), np.zeros((0, 4, 4))
    return (np.array([p["time"] for p in POSES]), np.stack([p["T_port"] for p in POSES]),
            np.stack([p["T_world"] for p in POSES]))


def latest_pose():
    """Most recent pose dict, or None."""
    return POSES[-1] if POSES else None


def quat_R(w, x, y, z):
    n = math.sqrt(w * w + x * x + y * y + z * z) or 1.0
    w, x, y, z = w / n, x / n, y / n, z / n
    return np.array([[1 - 2 * (y * y + z * z), 2 * (x * y - w * z), 2 * (x * z + w * y)],
                     [2 * (x * y + w * z), 1 - 2 * (x * x + z * z), 2 * (y * z - w * x)],
                     [2 * (x * z - w * y), 2 * (y * z + w * x), 1 - 2 * (x * x + y * y)]])


def head_to_camera_cv():
    """Fixed transform Head body -> camera (OpenCV axes), the same ops as the TipCamera prim."""
    def rot4(R):
        M = np.eye(4)
        M[:3, :3] = R
        return M
    T = np.eye(4)
    T[1, 3] = 0.0002                                           # translate 0.2 mm along the head
    a, r = math.radians(90.0), math.radians(CAMERA_ROLL_DEG)
    Rx = np.array([[1, 0, 0], [0, math.cos(a), -math.sin(a)], [0, math.sin(a), math.cos(a)]])
    Rz = np.array([[math.cos(r), -math.sin(r), 0], [math.sin(r), math.cos(r), 0], [0, 0, 1]])
    return T @ rot4(Rx) @ rot4(Rz) @ np.diag([1.0, -1.0, -1.0, 1.0])   # USD camera -> OpenCV axes


def look_at(eye, target, up, roll_deg=0.0):
    """USD camera transform (row-vector Gf matrix) at eye, looking at target, with up as close to up as possible,
    then turned by roll_deg about the view axis."""
    f = unit(np.asarray(target, float) - np.asarray(eye, float))
    z = -f                                             # USD cameras look down -Z
    x = np.cross(up, z)
    if np.linalg.norm(x) < 1e-6:
        x = np.cross([1.0, 0.0, 0.0], z)
    x = unit(x)
    y = np.cross(z, x)
    if roll_deg:
        a = math.radians(roll_deg)
        x, y = math.cos(a) * x + math.sin(a) * y, -math.sin(a) * x + math.cos(a) * y
    return Gf.Matrix4d(*x, 0, *y, 0, *z, 0, *np.asarray(eye, float), 1)


def engine_triangles(stage, center, radius, mpu=1.0):
    """World triangles (A, B, C) of every visible engine mesh within radius of center (probes and cutters skipped)."""
    xfc = UsdGeom.XformCache()
    out = []
    for p in Usd.PrimRange(stage.GetPseudoRoot()):
        if not p.IsA(UsdGeom.Mesh):
            continue
        path = str(p.GetPath())
        if path.startswith(ROOT) or "cutter" in path.lower():
            continue
        if UsdGeom.Imageable(p).ComputeVisibility() == UsdGeom.Tokens.invisible:
            continue
        m = UsdGeom.Mesh(p)
        P, cnt, idx = m.GetPointsAttr().Get(), m.GetFaceVertexCountsAttr().Get(), m.GetFaceVertexIndicesAttr().Get()
        if not P or not cnt or not idx:
            continue
        X = xfc.GetLocalToWorldTransform(p)
        X = np.array([[X[i][j] for j in range(4)] for i in range(4)])
        W = (np.hstack([np.asarray(P, float), np.ones((len(P), 1))]) @ X)[:, :3] * mpu
        lo, hi = W.min(0), W.max(0)
        if np.linalg.norm(np.maximum(0.0, np.maximum(lo - center, center - hi))) > radius:
            continue                                     # whole mesh too far away
        cnt, idx = np.asarray(cnt), np.asarray(idx)
        start = np.r_[0, np.cumsum(cnt)[:-1]]
        for k in range(1, int(cnt.max()) - 1):           # fan-triangulate every face
            f = cnt > k + 1
            tri = np.stack([idx[start[f]], idx[start[f] + k], idx[start[f] + k + 1]], 1)
            T = W[tri]
            near = np.linalg.norm(T.mean(1) - center, axis=1) < radius
            if near.any():
                out.append(T[near])
    T = np.concatenate(out) if out else np.zeros((0, 3, 3))
    return T[:, 0], T[:, 1], T[:, 2]


def prep_tris(A, B, C):
    """Triangles + their bounding boxes, ready for many segment tests."""
    A, B, C = (np.asarray(x, float) for x in (A, B, C))
    return dict(A=A, e1=B - A, e2=C - A, lo=np.minimum(np.minimum(A, B), C), hi=np.maximum(np.maximum(A, B), C))


def segment_blocked(o, q, T, stop=0.97):
    """True if the straight segment o -> (most of the way to) q crosses any triangle of T (from prep_tris)."""
    if len(T["A"]) == 0:
        return False
    qs = o + stop * (q - o)
    sel = np.all(T["hi"] >= np.minimum(o, qs), 1) & np.all(T["lo"] <= np.maximum(o, qs), 1)   # boxes that touch
    if not sel.any():
        return False
    A, e1, e2 = T["A"][sel], T["e1"][sel], T["e2"][sel]
    d = q - o
    h = np.cross(d, e2)
    a = (e1 * h).sum(1)
    ok = np.abs(a) > 1e-14
    f = np.where(ok, 1.0 / np.where(ok, a, 1.0), 0.0)
    s = o - A
    u = f * (s * h).sum(1)
    qq = np.cross(s, e1)
    v = f * (qq @ d)
    t = f * (qq * e2).sum(1)
    return bool(np.any(ok & (u >= 0) & (v >= 0) & (u + v <= 1) & (t > 1e-4) & (t < stop)))


def build_observer(stage, root, eye, target, up):
    """Xform with an (invisible) camera. Returns (transform op, camera path)."""
    path = root + "Observer"
    if stage.GetPrimAtPath(path):
        stage.RemovePrim(path)
    x = UsdGeom.Xform.Define(stage, path)
    op = x.AddTransformOp()
    op.Set(look_at(eye, target, up))
    cam = UsdGeom.Camera.Define(stage, path + "/Camera")
    cam.CreateFocalLengthAttr(11.0)                       # wide (~87 deg horizontal)
    cam.CreateHorizontalApertureAttr(20.955)
    cam.CreateVerticalApertureAttr(20.955 * 9 / 16)
    cam.CreateClippingRangeAttr(Gf.Vec2f(0.001, 5.0))
    UsdGeom.Imageable(cam).MakeInvisible()                # no camera icon in the other views
    return op, path + "/Camera"


def open_observer_window(cam_path):
