        stage,
        cfg.CONNECTOR_MATERIAL_PATH,
        density=cfg.CONNECTOR_DENSITY,
        dynamic_friction=cfg.CONNECTOR_DYNAMIC_FRICTION,
        youngs_modulus=cfg.CONNECTOR_YOUNGS_MODULUS,
        poissons_ratio=cfg.CONNECTOR_POISSONS_RATIO,
        damping_scale=cfg.CONNECTOR_DAMPING_SCALE,
        elasticity_damping=cfg.CONNECTOR_ELASTICITY_DAMPING,
    )

    deformableUtils.add_physx_deformable_body(
        stage,
        path,
        simulation_hexahedral_resolution=cfg.CONNECTOR_SIMULATION_HEX_RESOLUTION,
        collision_simplification=True,
        self_collision=cfg.CONNECTOR_SELF_COLLISION,
        solver_position_iteration_count=cfg.CONNECTOR_SOLVER_POSITION_ITERATIONS,
    )

    physicsUtils.add_physics_material_to_prim(stage, cylinder_prim, cfg.CONNECTOR_MATERIAL_PATH)

    return cylinder_prim


def create_attachment(stage, attachment_path, deformable_path, rigid_path, overlap_offset):
    """PhysxAutoAttachmentAPI with collision filtering enabled -- without
    filtering, the deformable's collision mesh and the rigid body's
    collision mesh fight the attachment constraint every frame, causing
    visible jitter at the seam."""
    deformable_prim = stage.GetPrimAtPath(deformable_path)
    rigid_prim = stage.GetPrimAtPath(rigid_path)

    attachment = PhysxSchema.PhysxPhysicsAttachment.Define(stage, attachment_path)
    attachment.GetActor0Rel().SetTargets([deformable_prim.GetPath()])
    attachment.GetActor1Rel().SetTargets([rigid_prim.GetPath()])

    auto_attachment = PhysxSchema.PhysxAutoAttachmentAPI.Apply(attachment.GetPrim())
    auto_attachment.CreateEnableDeformableVertexAttachmentsAttr(True)
    auto_attachment.CreateDeformableVertexOverlapOffsetAttr(overlap_offset)
    auto_attachment.CreateEnableCollisionFilteringAttr(True)

    return attachment.GetPrim()


def build_connector():
    stage = get_stage()

    prim = stage.GetPrimAtPath(cfg.CONNECTOR_PATH)
    if prim.IsValid():
        stage.RemovePrim(cfg.CONNECTOR_PATH)
        print(f"Deleted old prim: {cfg.CONNECTOR_PATH}")

    shaft_base, direction = get_shaft_base_and_direction(stage)
    print(f"Shaft base: {shaft_base}, direction: {direction}")

    # Cable extends BACKWARD from the shaft's base (opposite the neck),
    # attached at that end only -- far end is FREE (real cantilever).
    cable_start = shaft_base
    cable_direction = -Gf.Vec3d(direction)
    create_deformable_connector(stage, cfg.CONNECTOR_PATH, cable_start, cable_direction, cfg.PROBE_RADIUS, cfg.CONNECTOR_LENGTH)
    print(f"Deformable cable created: {cfg.CONNECTOR_PATH}")

    overlap_offset = cfg.PROBE_RADIUS * cfg.CONNECTOR_ATTACHMENT_OVERLAP_MULTIPLIER
    create_attachment(stage, f"{cfg.CONNECTOR_PATH}/attachment_to_shaft", cfg.CONNECTOR_PATH, cfg.SHAFT_PRIM_PATH, overlap_offset)
    print("Attachment created: connector-to-shaft (far end is FREE -- cantilever)")
    print("Shaft and BendingNeck were NOT modified.")


if __name__ == "__main__":
    build_connector()
