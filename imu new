"""
Paste into Window > Script Editor while Isaac Sim is already open.
Press PLAY after "Setup complete" prints.

Root-cause fix: the previous version added sideways (X/Z) drift to
the ball's path to give the IMU real signal, but the landmark cubes
sit fixed at X=0 -- so the ball (and the camera riding on it) kept
wandering away from directly above them, meaning the camera mostly
missed them. Path is now straight along X=0/Z=const (matching the
cubes), and instead gets its real IMU signal from a varying forward
speed (real linear acceleration) and a gentler angular velocity wobble
(real gyro signal) that doesn't displace the ball sideways.

Cubes also enlarged a bit (0.3 -> 0.5) for extra margin.
"""

import asyncio
import shutil
from pathlib import Path

import numpy as np
import omni.usd
from pxr import PhysxSchema, UsdLux

from isaacsim.core.api import World
from isaacsim.core.api.physics_context import PhysicsContext
from isaacsim.core.api.objects import DynamicSphere, FixedCuboid
from isaacsim.sensors.physics import IMUSensor
from isaacsim.sensors.camera import Camera

from rosbags.rosbag2 import Writer
from rosbags.typesys import Stores, get_typestore

# ---- config ----
BALL_RADIUS = 0.05
START_POS = np.array([0.0, 0.0, 1.0])
NUM_STEPS = 1000
FRAME_ID = "ball_imu"
BAG_PATH = Path("C:/Users/castmar16/Desktop/imu_bag")  # <-- confirm this is right

CAMERA_RESOLUTION = (320, 240)
CAMERA_EVERY_N_STEPS = 3
CAMERA_TRANSLATION = np.array([0.0, BALL_RADIUS, 0.0])

_state = {}


def record_step(step_size):
    s = _state
    if s["count"] >= NUM_STEPS:
        return
    s["count"] += 1
    T = s["types"]

    t = s["count"] / 60.0

    # Straight path along X=0/Z=const (stays over the cubes) -- real
    # signal now comes from varying forward speed + gentle angular wobble
    vy = 0.5 + 0.15 * np.sin(0.4 * t)
    s["ball"].set_linear_velocity(np.array([0.0, vy, 0.0]))

    wx = 0.05 * np.sin(0.4 * t)
    wy = 0.08 * np.cos(0.3 * t)
    wz = 0.03 * np.sin(0.2 * t)
    s["ball"].set_angular_velocity(np.array([wx, wy, wz]))

    frame = s["imu"].get_current_frame()
    sec = int(t)
    nanosec = int((t - sec) * 1e9)
    timestamp_ns = int(t * 1e9)

    ow, ox, oy, oz = frame.get("orientation", [1.0, 0.0, 0.0, 0.0])
    lax, lay, laz = frame.get("lin_acc", [0.0, 0.0, 0.0])
    avx, avy, avz = frame.get("ang_vel", [0.0, 0.0, 0.0])

    imu_msg = T["Imu"](
        header=T["Header"](stamp=T["RosTime"](sec=sec, nanosec=nanosec), frame_id=FRAME_ID),
        orientation=T["Quaternion"](x=ox, y=oy, z=oz, w=ow),
        orientation_covariance=s["zero_cov"],
        angular_velocity=T["Vector3"](x=avx, y=avy, z=avz),
        angular_velocity_covariance=s["zero_cov"],
        linear_acceleration=T["Vector3"](x=lax, y=lay, z=laz),
        linear_acceleration_covariance=s["zero_cov"],
    )
    s["writer"].write(
        s["conn_imu"], timestamp_ns, s["typestore"].serialize_cdr(imu_msg, T["Imu"].__msgtype__)
    )

    pos, _quat = s["ball"].get_world_pose()
    leica_msg = T["PointStamped"](
        header=T["Header"](stamp=T["RosTime"](sec=sec, nanosec=nanosec), frame_id="world"),
        point=T["Point"](x=float(pos[0]), y=float(pos[1]), z=float(pos[2])),
    )
    s["writer"].write(
        s["conn_leica"], timestamp_ns, s["typestore"].serialize_cdr(leica_msg, T["PointStamped"].__msgtype__)
    )

    if s["count"] % CAMERA_EVERY_N_STEPS == 0:
        rgba = s["camera"].get_rgba()
        if rgba is not None and rgba.size > 0:
            rgb = np.asarray(rgba[:, :, :3], dtype=np.float32)
            gray = (0.299 * rgb[:, :, 0] + 0.587 * rgb[:, :, 1] + 0.114 * rgb[:, :, 2]).astype(np.uint8)
            height, width = gray.shape[0], gray.shape[1]
            img_msg = T["Image"](
                header=T["Header"](stamp=T["RosTime"](sec=sec, nanosec=nanosec), frame_id="cam0"),
                height=height,
                width=width,
                encoding="mono8",
                is_bigendian=0,
                step=width,
                data=gray.flatten(),
            )
            s["writer"].write(
                s["conn_cam0"], timestamp_ns, s["typestore"].serialize_cdr(img_msg, T["Image"].__msgtype__)
            )

    if s["count"] >= NUM_STEPS:
        s["writer"].close()
        s["world"].pause()
        print(f"Done -- wrote {s['count']} imu0/leica samples (+cam0 mono8 frames) to {BAG_PATH}")


