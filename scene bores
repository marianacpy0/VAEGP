def look_through(cam_path):
    try:
        from omni.kit.viewport.utility import get_active_viewport
        get_active_viewport().camera_path = cam_path
    except Exception as e:
        carb.log_error(f"[borescope] could not set viewport camera: {e}")


def open_view_window(cam_path):
    global _bs_view
    try:
        _bs_view.destroy()
    except Exception:
        pass
    _bs_view = None
    try:
        from omni.kit.viewport.utility import create_viewport_window
        _bs_view = create_viewport_window("Borescope View", width=CAM_RES[0] // 2 + 20,
                                          height=CAM_RES[1] // 2 + 60)
        _bs_view.viewport_api.camera_path = cam_path
        try:
            _bs_view.viewport_api.resolution = CAM_RES
        except Exception:
            pass
    except Exception as e:
        carb.log_error(f"[borescope] could not open the view window: {e}. "
                       f"Use the viewport camera menu and pick {cam_path}.")


def frame_prim(path):
    try:
        omni.usd.get_context().get_selection().set_selected_prim_paths([path], True)
        from omni.kit.viewport.utility import get_active_viewport, frame_viewport_selection
        frame_viewport_selection(get_active_viewport())
    except Exception as e:
        carb.log_warn(f"[borescope] select {path} and press F to frame it ({e})")


def set_auto_exposure(on):
    try:
        carb.settings.get_settings().set("/rtx/post/histogram/enabled", bool(on))
    except Exception:
        pass


