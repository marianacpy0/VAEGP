        if fn:
            fn()
        self.s.update()
        self._refresh()

    def _cutter(self):
        self.s.set_cutter_visibility()

    def _refresh(self):
        self.info.text = self.s.info
        self.pose.text = self.s.pose_text

    def _reload(self, path):
        old = self.s.port
        if old is not None:                        # restore old cutter visibility
            UsdGeom.Imageable(old["prim"]).MakeVisible()
        if self.s.find_port(path):
            self.s.build()
            self.path_model.set_value(self.s.port_path)
        self._refresh()

    def _use_path(self):
        self._reload(self.path_model.get_value_as_string())

    def _use_sel(self):
        sel = [s for s in omni.usd.get_context().get_selection().get_selected_prim_paths()
               if not s.startswith(ROOT_PATH)]
        if sel:
            self._reload(sel[0])

    def destroy(self):
        self.window.destroy()


